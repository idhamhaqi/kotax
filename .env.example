# ===========================================
# ENVIRONMENT CONFIGURATION
# ===========================================

# Environment mode: development / production
NODE_ENV=production
PORT=3000

# ===========================================
# SECURITY SECRETS
# ===========================================

# Session secret - MUST BE CHANGED IN PRODUCTION!
SESSION_SECRET=your-very-secure-session-secret-change-this

# JWT secret for authentication tokens
JWT_SECRET=your-very-secure-jwt-secret-change-this

# ===========================================
# DATABASE CONFIGURATION
# ===========================================

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-database-password
DB_NAME=kuota_aggregator
DB_CONNECTION_LIMIT=1000

# ===========================================
# REDIS CONFIGURATION
# ===========================================

# Redis URL for session store & Socket.IO adapter
# Format: redis://[username:password@]host:port
REDIS_URL=redis://localhost:6379

# ===========================================
# SERVER LIMITS
# ===========================================

# Maximum concurrent Socket.IO connections
MAX_CONNECTIONS=1000

# Rate limiting window (milliseconds)
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests per window
RATE_LIMIT_MAX_REQUESTS=1000

# ===========================================
# ADMIN CONFIGURATION
# ===========================================

# Admin access key - MUST BE CHANGED IN PRODUCTION!
# Access admin panel login: https://yourdomain.com/admin/login?key=YOUR_KEY_HERE
ADMIN_KEY=@Polar007
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456

# ===========================================
# COOKIE & SESSION CONFIGURATION (Production)
# ===========================================

# Optional: Set cookie domain for production (e.g., .yourdomain.com)
# Leave empty for default behavior
# COOKIE_DOMAIN=.yourdomain.com

# ===========================================
# WEBHOOK CONFIGURATION
# ===========================================
# Secret token for Notif Bridge Android Webhook authentication (Optional)
# WEBHOOK_SECRET_TOKEN=your-webhook-secret-token

