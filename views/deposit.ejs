                                loadMoreContainer.classList.add('hidden');
                            }
                        }
                    }
                }
            } catch (error) {
                console.error('Error loading mobile deposit history:', error);
            }
        }

        // Setup load more button for mobile
        document.getElementById('loadMoreBtnMobile').addEventListener('click', () => {
            if (hasMoreMobileDeposit) {
                mobileDepositOffset += limit;
                loadMobileDepositHistory(true);
            }
        });

        // Initial load
        loadPaymentMethods();
        loadDesktopDepositHistory(1);
        loadMobileDepositHistory(false);

        let depositToCancel = null;

        function closeCancelModal() {
            document.getElementById('cancelDepositModal').classList.add('hidden');
            document.getElementById('cancelDepositModal').classList.remove('flex');
            depositToCancel = null;
        }

        // Handle deposit cancellation modal
        function cancelDepositAction(depositId) {
            depositToCancel = depositId;
            document.getElementById('cancelDepositModal').classList.remove('hidden');
            document.getElementById('cancelDepositModal').classList.add('flex');
        }

        document.getElementById('btnConfirmCancel').addEventListener('click', async () => {
            if (!depositToCancel) return;
            
            const btn = document.getElementById('btnConfirmCancel');
            const originalText = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Proses...';
            btn.disabled = true;

            try {
                const response = await fetch('/api/deposit/cancel', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ depositId: depositToCancel })
                });

                const result = await response.json();
                
                if (result.success) {
                    showToast(result.message, 'success');
                    closeCancelModal();
                    loadDesktopDepositHistory(1);
                    loadMobileDepositHistory(false);
                } else {
                    showToast(result.message, 'error');
                }
            } catch (error) {
                console.error('Error cancelling deposit:', error);
                showToast('Gagal membatalkan deposit', 'error');
            } finally {
                btn.innerHTML = originalText;
                btn.disabled = false;
            }
        });
    </script>

    <script src="/socket.io/socket.io.js"></script>
    <script>
        // Real-time Auto Approval Handler & Smart Polling for Deposit Page
        let currentUserId = null;
        let depositPollTimer = null;

        function handleAutoApproveSuccess(amount, message) {
            // 1. Instantly close all modals
            if (typeof closeModal === 'function') closeModal();
            
            const confirmModal = document.getElementById('confirmModal');
            if (confirmModal) {
                confirmModal.classList.add('hidden');
                confirmModal.classList.remove('flex');
            }
            const depositModal = document.getElementById('depositModal');
            if (depositModal) {
                depositModal.classList.add('hidden');
                depositModal.classList.remove('flex');
            }
            const cancelModal = document.getElementById('cancelDepositModal');
            if (cancelModal) {
                cancelModal.classList.add('hidden');
                cancelModal.classList.remove('flex');
            }

            // 2. Stop polling timer
            if (depositPollTimer) {
                clearInterval(depositPollTimer);
                depositPollTimer = null;
            }

            // 3. Clear current deposit state
            currentDeposit = null;

            // 4. Show success toast notification
            const displayMsg = message || (amount ? `Deposit sebesar Rp ${parseInt(amount).toLocaleString('id-ID')} telah diverifikasi & disetujui otomatis!` : 'Deposit Anda telah diverifikasi & disetujui otomatis!');
            showToast(displayMsg, 'success');

            // 5. Reload history tables & balance
            if (typeof loadDesktopDepositHistory === 'function') loadDesktopDepositHistory(1);
            if (typeof loadMobileDepositHistory === 'function') loadMobileDepositHistory(false);
            if (typeof updateHeaderBalance === 'function') updateHeaderBalance();
        }

        // Smart polling every 3 seconds to ensure real-time auto-approval even if socket reconnects
        function startSmartDepositPolling() {
            if (depositPollTimer) clearInterval(depositPollTimer);

            depositPollTimer = setInterval(async () => {
                try {
                    const res = await fetch('/api/deposit/initiated');
                    const result = await res.json();

                    if (result.success) {
                        if (currentDeposit && currentDeposit.id) {
                            const stillInitiated = result.deposits && result.deposits.some(d => d.id === currentDeposit.id);
                            if (!stillInitiated) {
                                // Deposit has been approved by Webhook or Admin!
                                handleAutoApproveSuccess(currentDeposit.uniqueAmount, 'Deposit Anda telah diverifikasi & disetujui otomatis!');
                            }
                        } else if (!result.deposits || result.deposits.length === 0) {
                            // No initiated deposits remain
                            if (typeof loadDesktopDepositHistory === 'function') loadDesktopDepositHistory(1);
                            if (typeof loadMobileDepositHistory === 'function') loadMobileDepositHistory(false);
                        }
                    }
                } catch (_e) {}
            }, 3000);
        }

        // Start polling on page load
        startSmartDepositPolling();

        // Socket.IO Realtime listeners
        if (typeof io !== 'undefined') {
            const depositSocket = io();
            fetch('/api/profile/data')
                .then(res => res.json())
                .then(data => {
                    if (data.success && data.user && data.user.id) {
                        currentUserId = data.user.id;
                        depositSocket.emit('register-user', data.user.id);
                    }
                })
                .catch(err => console.error('Socket register error:', err));

            depositSocket.on('deposit-approved', (data) => {
                handleAutoApproveSuccess(data.amount, data.message);
            });

            depositSocket.on('deposit-status-changed', (data) => {
                if (currentUserId && Number(data.userId) === Number(currentUserId) && data.status === 'approved') {
                    handleAutoApproveSuccess(data.amount, 'Deposit Anda telah diverifikasi & disetujui otomatis!');
                }
            });

            depositSocket.on('balance-updated', () => {
                if (typeof loadDesktopDepositHistory === 'function') loadDesktopDepositHistory(1);
                if (typeof loadMobileDepositHistory === 'function') loadMobileDepositHistory(false);
                if (typeof updateHeaderBalance === 'function') updateHeaderBalance();
            });
        }
    </script>
    <%- include('partials/pwa-script') %>
</body>
</html>
