        // Show custom confirmation modal
        function showConfirmModal(amount) {
            return new Promise((resolve) => {
                confirmationResolve = resolve;

                document.getElementById('confirmAmount').textContent =
                    'Rp ' + amount.toLocaleString('id-ID');

                const modal = document.getElementById('confirmModal');
                modal.classList.remove('hidden');
                modal.classList.add('flex');
            });
        }

        // Handle confirmation accept
        function acceptConfirmation() {
            const modal = document.getElementById('confirmModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');

            if (confirmationResolve) {
                confirmationResolve(true);
                confirmationResolve = null;
            }
        }

        // Handle confirmation cancel
        function cancelConfirmation() {
            const modal = document.getElementById('confirmModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');

            if (confirmationResolve) {
                confirmationResolve(false);
                confirmationResolve = null;
            }
        }

        async function selectDeposit(amount) {
            if (!selectedPaymentMethodId) {
                showToast('Silakan pilih metode pembayaran terlebih dahulu', 'error');
                return;
            }

            const chosenMethod = availablePaymentMethods.find(m => m.id === selectedPaymentMethodId);
            if (chosenMethod && amount < chosenMethod.min_deposit) {
                showToast(`Minimal deposit untuk ${chosenMethod.name} adalah Rp ${parseInt(chosenMethod.min_deposit).toLocaleString('id-ID')}`, 'error');
                return;
            }

            const confirmed = await showConfirmModal(amount);

            if (!confirmed) {
                return; // User cancel
            }

            try {
                const response = await fetch('/api/deposit/initiate', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ amount, paymentMethodId: selectedPaymentMethodId })
                });

                const result = await response.json();

                if (response.ok && result.success) {
                    currentDeposit = result.deposit;
                    showModal(result.deposit);

                    loadDesktopDepositHistory(1);
                    loadMobileDepositHistory(false);
                } else {
                    showToast(result.message || 'Gagal membuat deposit', 'error');
                }
            } catch (error) {
                console.error('Error initiating deposit:', error);
                showToast('Terjadi kesalahan. Silakan coba lagi.', 'error');
            }
        }

        // Confirm existing deposit (untuk deposit yang sudah initiated)
        async function confirmExistingDeposit(depositId) {
            try {
                const response = await fetch('/api/deposit/initiated');
                const result = await response.json();

                if (result.success) {
                    const deposit = result.deposits.find(d => d.id === depositId);
                    if (deposit) {
                        const normalizedDeposit = {
                            id: deposit.id,
                            amount: deposit.amount,
                            uniqueAmount: deposit.unique_amount,
                            status: deposit.status,
                            paymentMethod: result.paymentMethod,
                            adminContact: result.adminContact
                        };
                        currentDeposit = normalizedDeposit;
                        showModal(normalizedDeposit);
                    } else {
                        showToast('Deposit tidak ditemukan', 'error');
                    }
                } else {
                    showToast(result.message, 'error');
                }
            } catch (error) {
                console.error('Error loading deposit:', error);
                showToast('Error loading deposit', 'error');
            }
        }

        function showModal(deposit) {
            console.log('showModal called with deposit:', deposit);

            const modal = document.getElementById('depositModal');
            const paymentInfo = document.getElementById('paymentInfo');
            const contactInfo = document.getElementById('contactInfo');

            if (!deposit || !deposit.amount || !deposit.uniqueAmount) {
                showToast('Data deposit tidak valid', 'error');
                return;
            }

            document.getElementById('depositAmount').value = deposit.amount;
            document.getElementById('depositUniqueAmount').value = deposit.uniqueAmount;

            const formattedAmount = 'Rp ' + formatUniqueAmount(deposit.uniqueAmount);

            if (deposit.paymentMethod) {
                paymentInfo.classList.remove('hidden');
                contactInfo.classList.add('hidden');

                const pm = deposit.paymentMethod;
                const isQris = (pm.category === 'QRIS' || Boolean(pm.qrCodeUrl));

                document.getElementById('modalBankName').textContent = pm.name || pm.bankName || 'Payment Method';
                document.getElementById('modalAccountHolder').textContent = pm.accountHolder || '-';
                document.getElementById('modalUniqueAmount').textContent = formattedAmount;

                const modalBadge = document.getElementById('modalPaymentBadge');
                if (modalBadge) modalBadge.textContent = pm.category || 'Aktif';

                const qrisContainer = document.getElementById('modalQrisContainer');
                const accRow = document.getElementById('modalAccountNumberRow');

                const qrisUrl = deposit.qrisDataUrl || pm.qrCodeUrl;
                const isDynamic = deposit.isDynamicQris || pm.isDynamicQris;

                if (isQris && qrisUrl) {
                    qrisContainer.classList.remove('hidden');
                    document.getElementById('modalQrCodeImg').src = qrisUrl;
                    
                    const hintEl = document.getElementById('modalQrisHint');
                    if (hintEl) {
                        if (isDynamic) {
                            hintEl.innerHTML = '<i class="fas fa-check-circle text-emerald-500"></i> Nominal Rp ' + formatUniqueAmount(deposit.uniqueAmount) + ' otomatis terisi';
                        } else {
                            hintEl.innerHTML = '<i class="fas fa-info-circle text-purple-500"></i> Masukkan Rp ' + formatUniqueAmount(deposit.uniqueAmount) + ' saat transfer';
                        }
                    }
                    if (accRow) accRow.classList.add('hidden');
                } else {
                    qrisContainer.classList.add('hidden');
                    if (accRow) {
                        accRow.classList.remove('hidden');
                        document.getElementById('modalBankAccount').textContent = pm.accountNumber || '-';
                    }
                }
            } else {
                paymentInfo.classList.add('hidden');
                contactInfo.classList.remove('hidden');

                const adminContact = deposit.adminContact || '';
                const telegramUsername = adminContact.replace('@', '');
                const telegramLink = document.getElementById('telegramLink');
                telegramLink.href = `https://t.me/${telegramUsername}`;

                const usernameDisplay = adminContact.startsWith('@') ? adminContact : '@' + adminContact;
                document.getElementById('modalAdminContactUsername').textContent = usernameDisplay;
                document.getElementById('modalUniqueAmountContact').textContent = formattedAmount;
            }

            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeModal() {
            const modal = document.getElementById('depositModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            document.getElementById('uploadForm').reset();
            document.getElementById('imagePreview').classList.add('hidden');
            currentDeposit = null;
        }

        // Handle upload form
        document.getElementById('uploadForm').addEventListener('submit', async (e) => {
            e.preventDefault();

            const confirmBtn = document.getElementById('confirmBtn');
            confirmBtn.disabled = true;
            confirmBtn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> Processing...';

            const formData = new FormData(e.target);

            // Detect mode: new deposit or existing deposit
            let endpoint = '/api/deposit/confirm'; // Default: legacy mode for new deposit

            if (currentDeposit && currentDeposit.id) {
                // Existing deposit mode - use new upload-proof endpoint
                endpoint = '/api/deposit/upload-proof';
                formData.append('depositId', currentDeposit.id);
                // Remove amount & uniqueAmount karena sudah ada di DB
                formData.delete('amount');
                formData.delete('uniqueAmount');
            }

            try {
                const response = await fetch(endpoint, {
                    method: 'POST',
                    body: formData
                });

                const result = await response.json();

                if (response.ok && result.success) {
                    showToast(result.message, 'success');
                    closeModal();
                    loadDesktopDepositHistory(1);
                    loadMobileDepositHistory(false);
                } else {
                    showToast(result.message || 'Gagal mengupload bukti transfer', 'error');
                }
            } catch (error) {
                console.error('Error confirming deposit:', error);
                showToast('Terjadi kesalahan. Silakan coba lagi.', 'error');
            } finally {
                confirmBtn.disabled = false;
                confirmBtn.innerHTML = '<i class="fas fa-check-circle mr-2"></i> Konfirmasi Transfer';
            }
        });

