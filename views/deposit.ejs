                            } else if (d.status === 'initiated') {
                                statusBadge = '<span class="px-2 py-1 bg-blue-100 text-blue-700 rounded text-xs font-semibold"><i class="fas fa-hourglass-start"></i> Belum Upload</span>';
                            } else {
                                statusBadge = '<span class="px-2 py-1 bg-yellow-100 text-yellow-700 rounded text-xs font-semibold"><i class="fas fa-clock"></i> Pending</span>';
                            }

                            if (d.status === 'initiated') {
                                actionButton = `
                                    <div class="flex items-center gap-1.5 justify-end">
                                        <button onclick="confirmExistingDeposit(${d.id})" class="px-2.5 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-lg transition flex items-center gap-1 shadow-sm">
                                            <i class="fas fa-upload"></i> Konfirmasi
                                        </button>
                                        <button onclick="cancelDepositAction(${d.id})" class="px-2.5 py-1.5 bg-red-50 hover:bg-red-100 text-red-600 border border-red-200 text-xs font-bold rounded-lg transition flex items-center gap-1">
                                            <i class="fas fa-trash-alt"></i> Batalkan
