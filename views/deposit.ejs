                        if (paginationContainer) paginationContainer.classList.add('hidden');
                    } else {
                        if (paginationContainer) paginationContainer.classList.remove('hidden');

                        let desktopHTML = '';
                        result.deposits.forEach(d => {
                            let statusBadge = '';
                            let actionButton = '';

                            if (d.status === 'approved') {
                                statusBadge = '<span class="px-2 py-1 bg-green-100 text-green-700 rounded text-xs font-semibold"><i class="fas fa-check-circle"></i> Approved</span>';
