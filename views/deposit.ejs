        function submitCustomDeposit(device) {
            const input = document.getElementById(`customAmountInput${device}`);
            if (!input || !input.value) {
                showToast('Masukkan nominal deposit terlebih dahulu', 'error');
                return;
            }
            const val = parseInt(input.value);
            const chosenMethod = availablePaymentMethods.find(m => m.id === selectedPaymentMethodId);
            const minDep = chosenMethod ? parseFloat(chosenMethod.min_deposit || 100000) : 100000;

            if (isNaN(val) || val < minDep) {
                showToast(`Minimal deposit untuk ${chosenMethod ? chosenMethod.name : 'metode ini'} adalah Rp ${parseInt(minDep).toLocaleString('id-ID')}`, 'error');
                return;
            }
            selectDeposit(val);
        }

        function selectPaymentMethod(id) {
            selectedPaymentMethodId = id;
            renderPaymentMethods();
        }

        // Helper to copy modal fields to clipboard
        function copyModalField(elementId, labelName) {
            const text = document.getElementById(elementId)?.textContent?.trim();
            if (!text) return;
            navigator.clipboard.writeText(text).then(() => {
                showToast(`${labelName} berhasil disalin!`, 'success');
            }).catch(() => {
                const textarea = document.createElement('textarea');
                textarea.value = text;
                document.body.appendChild(textarea);
                textarea.select();
                document.execCommand('copy');
                document.body.removeChild(textarea);
                showToast(`${labelName} berhasil disalin!`, 'success');
            });
        }

        // Helper to copy raw integer unique amount (for mobile banking input)
        function copyUniqueAmountRaw() {
            if (!currentDeposit || !currentDeposit.uniqueAmount) {
                const elText = document.getElementById('modalUniqueAmount')?.textContent?.replace(/\D/g, '');
                if (elText) {
                    navigator.clipboard.writeText(elText);
                    showToast(`Jumlah transfer Rp ${parseInt(elText).toLocaleString('id-ID')} berhasil disalin!`, 'success');
                }
                return;
            }
            const rawAmount = parseInt(currentDeposit.uniqueAmount).toString();
            navigator.clipboard.writeText(rawAmount).then(() => {
                showToast(`Jumlah transfer Rp ${parseInt(rawAmount).toLocaleString('id-ID')} berhasil disalin!`, 'success');
            }).catch(() => {
                const textarea = document.createElement('textarea');
                textarea.value = rawAmount;
                document.body.appendChild(textarea);
                textarea.select();
                document.execCommand('copy');
                document.body.removeChild(textarea);
                showToast(`Jumlah transfer Rp ${parseInt(rawAmount).toLocaleString('id-ID')} berhasil disalin!`, 'success');
            });
        }

        // Helper to download QRIS image for mobile users
        function downloadQrisImage() {
            const img = document.getElementById('modalQrCodeImg');
            if (!img || !img.src) {
                showToast('Gambar QRIS belum dimuat', 'error');
                return;
            }

            const link = document.createElement('a');
            link.href = img.src;
            const amtStr = currentDeposit ? currentDeposit.uniqueAmount : 'qris';
            link.download = `qris-kuotax-rp${amtStr}.png`;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            showToast('Gambar QRIS berhasil di-download! Silakan scan lewat Galeri aplikasi m-Banking/E-Wallet Anda.', 'success');
        }

        // Format amount: 100257 -> "100.257" (tanpa desimal)
        function formatUniqueAmount(amount) {
            if (!amount || amount === '' || isNaN(amount)) {
                return '0';
            }

            const amountInt = parseInt(amount);
            if (isNaN(amountInt)) {
                return '0';
            }

            const amountStr = amountInt.toString();
            if (amountStr.length <= 3) return amountStr;

            const lastThree = amountStr.slice(-3);
            const remaining = amountStr.slice(0, -3);
            return remaining.replace(/\B(?=(\d{3})+(?!\d))/g, '.') + '.' + lastThree;
        }

