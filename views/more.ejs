<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Menu - KUOTAX</title>
    <%- include('partials/pwa-head') %>
    <link rel="stylesheet" href="/css/style.css?v=6">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .glass {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.3);
        }
    </style>
</head>
<body class="bg-gradient-to-br from-emerald-50 via-green-50 to-teal-50 min-h-screen">
    <%- include('partials/sidebar', { page: 'more' }) %>

    <!-- ============================================ -->
    <!-- MOBILE LAYOUT (visible only on < lg screens) -->
    <!-- ============================================ -->
    <div class="lg:hidden bg-[#f8fafb] min-h-screen pb-24">
        <!-- App Bar -->
        <div class="bg-white border-b border-gray-100 px-4 py-4 sticky top-0 z-20 flex items-center justify-between">
            <h1 class="text-lg font-bold text-gray-800 tracking-tight">Menu Lainnya</h1>
            <div class="w-8 h-8 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center">
                <i class="fas fa-ellipsis-h text-sm"></i>
            </div>
        </div>

        <div class="p-4 space-y-4">
            <!-- Account Section -->
            <div>
                <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-2 px-1">Akun</h3>
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                    <a href="/profile" class="flex items-center justify-between p-4 hover:bg-gray-50 transition border-b border-gray-50">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-full bg-yellow-50 text-yellow-600 flex items-center justify-center shrink-0">
                                <i class="fas fa-user text-sm"></i>
                            </div>
                            <div>
                                <h4 class="text-sm font-bold text-gray-800">Profil & Keamanan</h4>
                                <p class="text-[10px] text-gray-500 font-medium">Informasi akun, password</p>
                            </div>
                        </div>
                        <i class="fas fa-chevron-right text-gray-300 text-xs"></i>
                    </a>
                    
                    <a href="/referral" class="flex items-center justify-between p-4 hover:bg-gray-50 transition">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-full bg-purple-50 text-purple-600 flex items-center justify-center shrink-0">
                                <i class="fas fa-share-alt text-sm"></i>
                            </div>
                            <div>
                                <h4 class="text-sm font-bold text-gray-800">Program Referral</h4>
                                <p class="text-[10px] text-gray-500 font-medium">Ajak teman & dapatkan bonus</p>
                            </div>
                        </div>
                        <i class="fas fa-chevron-right text-gray-300 text-xs"></i>
                    </a>
                </div>
            </div>

            <!-- Transaction Section -->
            <div>
                <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-2 px-1">Transaksi</h3>
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                    <a href="/deposit" class="flex items-center justify-between p-4 hover:bg-gray-50 transition border-b border-gray-50">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
                                <i class="fas fa-money-bill-wave text-sm"></i>
                            </div>
                            <div>
                                <h4 class="text-sm font-bold text-gray-800">Deposit Saldo</h4>
                                <p class="text-[10px] text-gray-500 font-medium">Top up saldo KuotaX</p>
                            </div>
                        </div>
                        <i class="fas fa-chevron-right text-gray-300 text-xs"></i>
                    </a>
                    
                    <a href="/withdrawal" class="flex items-center justify-between p-4 hover:bg-gray-50 transition border-b border-gray-50">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-full bg-red-50 text-red-600 flex items-center justify-center shrink-0">
                                <i class="fas fa-money-check text-sm"></i>
                            </div>
                            <div>
                                <h4 class="text-sm font-bold text-gray-800">Penarikan (Withdraw)</h4>
                                <p class="text-[10px] text-gray-500 font-medium">Tarik saldo ke rekening</p>
                            </div>
                        </div>
                        <i class="fas fa-chevron-right text-gray-300 text-xs"></i>
                    </a>
                    
                    <a href="/history" class="flex items-center justify-between p-4 hover:bg-gray-50 transition border-b border-gray-50">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0">
                                <i class="fas fa-history text-sm"></i>
                            </div>
                            <div>
                                <h4 class="text-sm font-bold text-gray-800">Riwayat Transaksi</h4>
                                <p class="text-[10px] text-gray-500 font-medium">Daftar fill orders</p>
                            </div>
                        </div>
                        <i class="fas fa-chevron-right text-gray-300 text-xs"></i>
                    </a>

                    <a href="/catalog" class="flex items-center justify-between p-4 hover:bg-gray-50 transition">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-full bg-orange-50 text-orange-600 flex items-center justify-center shrink-0">
                                <i class="fas fa-store text-sm"></i>
                            </div>
                            <div>
                                <h4 class="text-sm font-bold text-gray-800">Katalog PPOB</h4>
                                <p class="text-[10px] text-gray-500 font-medium">Daftar produk & harga grosir</p>
                            </div>
                        </div>
                        <i class="fas fa-chevron-right text-gray-300 text-xs"></i>
                    </a>
                </div>
            </div>
            
            <!-- Support & Settings -->
            <div>
                <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-2 px-1">Bantuan & Lainnya</h3>
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                    <a href="/support" class="flex items-center justify-between p-4 hover:bg-gray-50 transition border-b border-gray-50">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0">
                                <i class="fas fa-headset text-sm"></i>
                            </div>
                            <div>
                                <h4 class="text-sm font-bold text-gray-800">Tiket Bantuan (Support)</h4>
                                <p class="text-[10px] text-gray-500 font-medium">Buat tiket kendala & hubungi tim</p>
                            </div>
                        </div>
                        <i class="fas fa-chevron-right text-gray-300 text-xs"></i>
                    </a>
                    
                    <a href="/api/auth/logout" class="flex items-center justify-between p-4 hover:bg-red-50 transition">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-full bg-red-50 text-red-600 flex items-center justify-center shrink-0">
                                <i class="fas fa-sign-out-alt text-sm"></i>
                            </div>
                            <div>
                                <h4 class="text-sm font-bold text-red-600">Keluar Akun</h4>
                                <p class="text-[10px] text-red-400 font-medium">Logout dari perangkat ini</p>
                            </div>
                        </div>
                        <i class="fas fa-chevron-right text-red-300 text-xs"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- ============================================ -->
    <!-- DESKTOP LAYOUT (visible only on >= lg screens) -->
    <!-- ============================================ -->
    <div class="hidden lg:block lg:ml-64 p-8 pb-8">
        <div class="mb-8">
            <h1 class="text-2xl lg:text-3xl font-bold text-gray-800 mb-2">Menu</h1>
            <p class="text-gray-600">Fitur dan pengaturan lainnya</p>
        </div>

        <!-- Menu Grid -->
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
            <!-- Deposit -->
            <a href="/deposit" class="glass rounded-2xl p-4 md:p-6 shadow-lg hover:shadow-xl transition transform hover:scale-105">
                <div class="w-10 h-10 md:w-12 md:h-12 rounded-lg bg-gradient-to-br from-green-400 to-green-600 flex items-center justify-center mb-3 md:mb-4">
                    <i class="fas fa-money-bill-wave text-white text-xl md:text-2xl"></i>
                </div>
                <h3 class="font-bold text-gray-800 mb-1">Deposit</h3>
                <p class="text-sm text-gray-600">Tambah saldo</p>
            </a>

            <!-- Withdrawal -->
            <a href="/withdrawal" class="glass rounded-2xl p-4 md:p-6 shadow-lg hover:shadow-xl transition transform hover:scale-105">
                <div class="w-10 h-10 md:w-12 md:h-12 rounded-lg bg-gradient-to-br from-red-400 to-red-600 flex items-center justify-center mb-3 md:mb-4">
                    <i class="fas fa-money-check text-white text-xl md:text-2xl"></i>
                </div>
                <h3 class="font-bold text-gray-800 mb-1">Penarikan</h3>
                <p class="text-sm text-gray-600">Tarik saldo</p>
            </a>

            <!-- Catalog -->
            <a href="/catalog" class="glass rounded-2xl p-4 md:p-6 shadow-lg hover:shadow-xl transition transform hover:scale-105">
                <div class="w-10 h-10 md:w-12 md:h-12 rounded-lg bg-gradient-to-br from-emerald-400 to-emerald-600 flex items-center justify-center mb-3 md:mb-4">
                    <i class="fas fa-store text-white text-xl md:text-2xl"></i>
                </div>
                <h3 class="font-bold text-gray-800 mb-1">Katalog PPOB</h3>
                <p class="text-sm text-gray-600">Produk & harga grosir</p>
            </a>

            <!-- Referral -->
            <a href="/referral" class="glass rounded-2xl p-4 md:p-6 shadow-lg hover:shadow-xl transition transform hover:scale-105">
                <div class="w-10 h-10 md:w-12 md:h-12 rounded-lg bg-gradient-to-br from-emerald-400 to-emerald-600 flex items-center justify-center mb-3 md:mb-4">
                    <i class="fas fa-share-alt text-white text-xl md:text-2xl"></i>
                </div>
                <h3 class="font-bold text-gray-800 mb-1">Referral</h3>
                <p class="text-sm text-gray-600">Program bonus</p>
            </a>

            <!-- Profile -->
            <a href="/profile" class="glass rounded-2xl p-4 md:p-6 shadow-lg hover:shadow-xl transition transform hover:scale-105">
                <div class="w-10 h-10 md:w-12 md:h-12 rounded-lg bg-gradient-to-br from-yellow-400 to-yellow-600 flex items-center justify-center mb-3 md:mb-4">
                    <i class="fas fa-user text-white text-xl md:text-2xl"></i>
                </div>
                <h3 class="font-bold text-gray-800 mb-1">Profil</h3>
                <p class="text-sm text-gray-600">Info akun</p>
            </a>

            <!-- History -->
            <a href="/history" class="glass rounded-2xl p-4 md:p-6 shadow-lg hover:shadow-xl transition transform hover:scale-105">
                <div class="w-10 h-10 md:w-12 md:h-12 rounded-lg bg-gradient-to-br from-pink-400 to-pink-600 flex items-center justify-center mb-3 md:mb-4">
                    <i class="fas fa-history text-white text-xl md:text-2xl"></i>
                </div>
                <h3 class="font-bold text-gray-800 mb-1">Riwayat</h3>
                <p class="text-sm text-gray-600">Fill orders</p>
            </a>
        </div>

        <!-- Logout Button -->
        <div class="mt-8">
            <a href="/api/auth/logout" class="glass rounded-2xl p-4 md:p-6 shadow-lg hover:shadow-xl transition flex items-center justify-between">
                <div class="flex items-center gap-4">
                    <div class="w-10 h-10 md:w-12 md:h-12 rounded-lg bg-gradient-to-br from-gray-400 to-gray-600 flex items-center justify-center">
                        <i class="fas fa-sign-out-alt text-white text-xl md:text-2xl"></i>
                    </div>
                    <div>
                        <h3 class="font-bold text-gray-800">Logout</h3>
                        <p class="text-sm text-gray-600">Keluar dari akun</p>
                    </div>
                </div>
                <i class="fas fa-chevron-right text-gray-400"></i>
            </a>
        </div>
    </div>

    <%- include('partials/footer') %>
    <%- include('partials/pwa-script') %>
</body>
</html>
