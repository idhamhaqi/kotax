<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profil - KUOTAX</title>
    <%- include('partials/pwa-head') %>
    <link rel="stylesheet" href="/css/style.css?v=6">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .glass {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.3);
        }
    </style>
</head>
<body class="bg-gradient-to-br from-emerald-50 via-green-50 to-teal-50 min-h-screen">
    <%- include('partials/sidebar', { page: 'profile' }) %>

    <!-- ============================================ -->
    <!-- MOBILE LAYOUT (visible only on < lg screens) -->
    <!-- ============================================ -->
    <div class="lg:hidden bg-[#f8fafb] min-h-screen pb-24">
        <!-- App Bar -->
        <div class="bg-white border-b border-gray-100 px-4 py-4 sticky top-0 z-20 flex items-center justify-between">
            <h1 class="text-lg font-bold text-gray-800 tracking-tight">Profil</h1>
            <div class="w-8 h-8 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center">
                <i class="fas fa-user text-sm"></i>
            </div>
        </div>

        <!-- Header Profile -->
        <div class="bg-white px-4 py-8 shadow-sm border-b border-gray-100 flex flex-col items-center justify-center relative overflow-hidden">
            <div class="absolute -top-10 -right-10 w-32 h-32 bg-emerald-50 rounded-full opacity-50 blur-2xl"></div>
            <div class="absolute -bottom-10 -left-10 w-32 h-32 bg-blue-50 rounded-full opacity-50 blur-2xl"></div>
            
            <div class="w-20 h-20 rounded-full bg-gradient-to-tr from-emerald-500 to-teal-400 text-white flex items-center justify-center text-3xl font-bold shadow-lg mb-3 relative z-10" id="avatarMobile">
                U
            </div>
            <h2 class="text-xl font-bold text-gray-800 relative z-10" id="fullNameMobile">-</h2>
            <p class="text-sm text-gray-500 relative z-10" id="emailMobile">-</p>
        </div>

        <div class="p-4 space-y-4">
            <!-- Bank Info -->
            <div class="bg-white rounded-2xl p-4 shadow-sm border border-gray-100">
                <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-4 px-1">Informasi Bank</h3>
                <div class="space-y-3">
                    <div class="flex items-center justify-between px-1">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center">
                                <i class="fas fa-building text-xs"></i>
                            </div>
                            <span class="text-sm font-medium text-gray-600">Bank</span>
                        </div>
                        <span class="text-sm font-bold text-gray-800" id="bankNameMobile">-</span>
                    </div>
                    <div class="flex items-center justify-between px-1">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center">
                                <i class="fas fa-wallet text-xs"></i>
                            </div>
                            <span class="text-sm font-medium text-gray-600">No. Rekening</span>
                        </div>
                        <span class="text-sm font-bold text-gray-800" id="bankAccountMobile">-</span>
                    </div>
                </div>
            </div>

            <!-- Account Info -->
            <div class="bg-white rounded-2xl p-4 shadow-sm border border-gray-100">
                <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-4 px-1">Detail Akun</h3>
                <div class="space-y-3">
                    <div class="flex items-center justify-between px-1">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-full bg-purple-50 text-purple-600 flex items-center justify-center">
                                <i class="fas fa-ticket-alt text-xs"></i>
                            </div>
                            <span class="text-sm font-medium text-gray-600">Kode Referral</span>
                        </div>
                        <span class="text-sm font-bold text-purple-600" id="referralCodeMobile">-</span>
                    </div>
                    <div class="flex items-center justify-between px-1">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-full bg-amber-50 text-amber-600 flex items-center justify-center">
                                <i class="fas fa-calendar-alt text-xs"></i>
                            </div>
                            <span class="text-sm font-medium text-gray-600">Bergabung</span>
                        </div>
                        <span class="text-sm font-bold text-gray-800" id="memberSinceMobile">-</span>
                    </div>
                </div>
            </div>

            <!-- Change Password -->
            <div class="bg-white rounded-2xl p-4 shadow-sm border border-gray-100 mb-4">
                <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-4 px-1">Keamanan Password</h3>
                <form id="changePasswordFormMobile" class="space-y-3">
                    <div>
                        <input type="password" name="currentPassword" required
                            class="w-full px-4 py-3 rounded-xl bg-gray-50 border-transparent focus:bg-white focus:border-emerald-500 focus:ring-2 focus:ring-emerald-200 outline-none transition text-sm"
                            placeholder="Password Lama">
                    </div>
                    <div>
                        <input type="password" name="newPassword" required
                            class="w-full px-4 py-3 rounded-xl bg-gray-50 border-transparent focus:bg-white focus:border-emerald-500 focus:ring-2 focus:ring-emerald-200 outline-none transition text-sm"
                            placeholder="Password Baru">
                    </div>
                    <div>
                        <input type="password" name="repeatPassword" required
                            class="w-full px-4 py-3 rounded-xl bg-gray-50 border-transparent focus:bg-white focus:border-emerald-500 focus:ring-2 focus:ring-emerald-200 outline-none transition text-sm"
                            placeholder="Ulangi Password Baru">
                    </div>
                    <button type="submit"
                        class="w-full mt-4 py-3.5 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-600 text-white font-bold text-sm hover:from-emerald-700 hover:to-teal-700 transition shadow-lg shadow-emerald-200">
                        Simpan Password Baru
                    </button>
                </form>
            </div>

            <!-- PIN Transaksi Section Mobile -->
            <div class="bg-white rounded-2xl p-4 shadow-sm border border-gray-100">
                <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-3 px-1">PIN Transaksi 6-Digit</h3>
                
                <div id="pinStatusActiveMobile" class="hidden p-3.5 bg-emerald-50 rounded-xl border border-emerald-200">
                    <div class="flex items-center gap-2 text-emerald-800 font-bold text-sm mb-1">
                        <i class="fas fa-shield-alt text-emerald-600 text-base"></i> PIN Transaksi Aktif
                    </div>
                    <p class="text-xs text-emerald-700 leading-relaxed">
                        PIN transaksi Anda telah terpasang. Jika Anda lupa PIN, silakan hubungi Admin untuk melakukan reset PIN.
                    </p>
                </div>

                <form id="setPinFormMobile" class="space-y-3">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">PIN Baru (6 Digit Angka)</label>
                        <input type="password" name="pin" maxlength="6" pattern="\d{6}" inputmode="numeric" required
                            class="w-full px-4 py-3 rounded-xl bg-gray-50 border-transparent focus:bg-white focus:border-emerald-500 focus:ring-2 focus:ring-emerald-200 outline-none transition text-sm font-mono tracking-widest text-center"
                            placeholder="******">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Ulangi PIN Baru</label>
                        <input type="password" name="confirmPin" maxlength="6" pattern="\d{6}" inputmode="numeric" required
                            class="w-full px-4 py-3 rounded-xl bg-gray-50 border-transparent focus:bg-white focus:border-emerald-500 focus:ring-2 focus:ring-emerald-200 outline-none transition text-sm font-mono tracking-widest text-center"
                            placeholder="******">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Password Akun saat ini</label>
                        <input type="password" name="password" required
                            class="w-full px-4 py-3 rounded-xl bg-gray-50 border-transparent focus:bg-white focus:border-emerald-500 focus:ring-2 focus:ring-emerald-200 outline-none transition text-sm"
                            placeholder="Password akun saat ini">
                    </div>
                    <button type="submit"
                        class="w-full py-3.5 rounded-xl bg-emerald-600 text-white font-bold text-sm hover:bg-emerald-700 transition shadow-lg shadow-emerald-100 flex items-center justify-center gap-2">
                        <i class="fas fa-lock"></i> Simpan PIN Transaksi
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- ============================================ -->
    <!-- DESKTOP LAYOUT (visible only on >= lg screens) -->
    <!-- ============================================ -->
    <div class="hidden lg:block lg:ml-64 p-8 pb-8">
        <div class="mb-8">
            <h1 class="text-2xl lg:text-3xl font-bold text-gray-800 mb-2">Profil</h1>
            <p class="text-gray-600">Informasi akun dan pengaturan</p>
        </div>

        <!-- Profile Info -->
        <div class="glass rounded-2xl p-4 lg:p-6 shadow-lg mb-8">
            <h3 class="text-lg font-bold text-gray-800 mb-4">
                <i class="fas fa-user text-emerald-600"></i> Informasi Akun
            </h3>
            <div class="grid md:grid-cols-2 gap-4">
                <div class="border-b border-gray-100 pb-2 md:border-0 md:pb-0">
                    <label class="block text-sm font-semibold text-gray-600 mb-1">Nama Lengkap</label>
                    <p id="fullNameDesktop" class="text-gray-800 font-medium">-</p>
                </div>
                <div class="border-b border-gray-100 pb-2 md:border-0 md:pb-0">
                    <label class="block text-sm font-semibold text-gray-600 mb-1">Email</label>
                    <p id="emailDesktop" class="text-gray-800 font-medium">-</p>
                </div>
                <div class="border-b border-gray-100 pb-2 md:border-0 md:pb-0">
                    <label class="block text-sm font-semibold text-gray-600 mb-1">Bank</label>
                    <p id="bankNameDesktop" class="text-gray-800 font-medium">-</p>
                </div>
                <div class="border-b border-gray-100 pb-2 md:border-0 md:pb-0">
                    <label class="block text-sm font-semibold text-gray-600 mb-1">No. Rekening</label>
                    <p id="bankAccountDesktop" class="text-gray-800 font-medium">-</p>
                </div>
                <div class="border-b border-gray-100 pb-2 md:border-0 md:pb-0">
                    <label class="block text-sm font-semibold text-gray-600 mb-1">Kode Referral</label>
                    <p id="referralCodeDesktop" class="text-gray-800 font-medium">-</p>
                </div>
                <div class="border-b border-gray-100 pb-2 md:border-0 md:pb-0">
                    <label class="block text-sm font-semibold text-gray-600 mb-1">Member Sejak</label>
                    <p id="memberSinceDesktop" class="text-gray-800 font-medium">-</p>
                </div>
            </div>
        </div>

        <!-- Change Password -->
        <div class="glass rounded-2xl p-4 lg:p-6 shadow-lg mb-6">
            <h3 class="text-lg font-bold text-gray-800 mb-4">
                <i class="fas fa-lock text-red-600"></i> Ubah Password
            </h3>
            <form id="changePasswordFormDesktop">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-gray-700 font-semibold mb-2">Password Saat Ini</label>
                        <input type="password" name="currentPassword" required
                            class="w-full px-4 py-3 rounded-lg bg-white/70 border border-gray-300 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-200 outline-none transition"
                            placeholder="Password lama">
                    </div>
                    <div>
                        <label class="block text-gray-700 font-semibold mb-2">Password Baru</label>
                        <input type="password" name="newPassword" required
                            class="w-full px-4 py-3 rounded-lg bg-white/70 border border-gray-300 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-200 outline-none transition"
                            placeholder="Password baru">
                    </div>
                    <div>
                        <label class="block text-gray-700 font-semibold mb-2">Ulangi Password</label>
                        <input type="password" name="repeatPassword" required
                            class="w-full px-4 py-3 rounded-lg bg-white/70 border border-gray-300 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-200 outline-none transition"
                            placeholder="Ulangi password">
                    </div>
                </div>
                <button type="submit"
                    class="mt-4 px-6 py-3 rounded-lg bg-gradient-to-r from-red-600 to-pink-600 text-white font-semibold hover:from-red-700 hover:to-pink-700 transition shadow-lg">
                    <i class="fas fa-key"></i> Ubah Password
                </button>
            </form>
        </div>

        <!-- PIN Transaksi Desktop -->
        <div class="glass rounded-2xl p-4 lg:p-6 shadow-lg">
            <h3 class="text-lg font-bold text-gray-800 mb-4 flex items-center gap-2">
                <i class="fas fa-shield-alt text-emerald-600"></i> PIN Transaksi 6-Digit (Keamanan Penarikan)
            </h3>
            
            <div id="pinStatusActiveDesktop" class="hidden p-4 bg-emerald-50 rounded-xl border border-emerald-200">
                <div class="flex items-center gap-2 text-emerald-800 font-bold text-base mb-1">
                    <i class="fas fa-check-circle text-emerald-600 text-lg"></i> PIN Transaksi Aktif & Terproteksi
                </div>
                <p class="text-sm text-emerald-700">
                    PIN transaksi Anda sudah terpasang. Setiap pengajuan penarikan dana akan meminta PIN 6 digit ini. Jika Anda lupa PIN, silakan hubungi Admin untuk melakukan verifikasi data dan reset PIN.
                </p>
            </div>

            <form id="setPinFormDesktop">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
                    <div>
                        <label class="block text-gray-700 font-semibold text-sm mb-2">PIN Transaksi Baru (6 Angka)</label>
                        <input type="password" name="pin" maxlength="6" pattern="\d{6}" inputmode="numeric" required
                            class="w-full px-4 py-3 rounded-lg bg-white/70 border border-gray-300 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-200 outline-none transition font-mono tracking-widest text-center"
                            placeholder="******">
                    </div>
                    <div>
                        <label class="block text-gray-700 font-semibold text-sm mb-2">Ulangi PIN Transaksi</label>
                        <input type="password" name="confirmPin" maxlength="6" pattern="\d{6}" inputmode="numeric" required
                            class="w-full px-4 py-3 rounded-lg bg-white/70 border border-gray-300 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-200 outline-none transition font-mono tracking-widest text-center"
                            placeholder="******">
                    </div>
                    <div>
                        <label class="block text-gray-700 font-semibold text-sm mb-2">Konfirmasi Password Akun</label>
                        <input type="password" name="password" required
                            class="w-full px-4 py-3 rounded-lg bg-white/70 border border-gray-300 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-200 outline-none transition"
                            placeholder="Password akun saat ini">
                    </div>
                </div>
                <button type="submit"
                    class="px-6 py-3 rounded-lg bg-emerald-600 text-white font-semibold hover:bg-emerald-700 transition shadow-lg flex items-center gap-2">
                    <i class="fas fa-lock"></i> Simpan PIN Transaksi
                </button>
            </form>
        </div>
    </div>

    <%- include('partials/footer') %>

    <div id="toast-container" class="fixed top-4 right-4 z-50"></div>

    <script src="/js/toast.js?v=<%= Date.now() %>"></script>
    <script src="/js/profile.js?v=<%= Date.now() %>"></script>
    <%- include('partials/pwa-script') %>
</body>
</html>
