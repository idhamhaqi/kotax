<%- include('partials/header', { title: 'Withdrawals Management', page: 'withdrawals' }) %>

<h2 class="text-3xl font-bold text-gray-800 mb-8">Withdrawals Management</h2>

<div class="bg-white rounded-xl shadow-lg p-6">
    <div class="overflow-x-auto">
        <table class="w-full">
            <thead>
                <tr class="border-b border-gray-200">
                    <th class="text-left py-3 px-4 text-sm font-semibold text-gray-600">ID</th>
                    <th class="text-left py-3 px-4 text-sm font-semibold text-gray-600">User</th>
                    <th class="text-left py-3 px-4 text-sm font-semibold text-gray-600">Email</th>
                    <th class="text-left py-3 px-4 text-sm font-semibold text-gray-600">Amount</th>
                    <th class="text-left py-3 px-4 text-sm font-semibold text-gray-600">Bank Name</th>
                    <th class="text-left py-3 px-4 text-sm font-semibold text-gray-600">Account Number</th>
                    <th class="text-left py-3 px-4 text-sm font-semibold text-gray-600">Account Name</th>
                    <th class="text-left py-3 px-4 text-sm font-semibold text-gray-600">Status</th>
                    <th class="text-left py-3 px-4 text-sm font-semibold text-gray-600">Created At</th>
                    <th class="text-left py-3 px-4 text-sm font-semibold text-gray-600">Actions</th>
                </tr>
            </thead>
            <tbody>
                <% withdrawals.forEach(withdrawal => { %>
                <tr class="border-b border-gray-100 hover:bg-gray-50 transition">
                    <td class="py-3 px-4 text-sm text-gray-600">#<%= withdrawal.id %></td>
                    <td class="py-3 px-4 text-sm font-semibold text-gray-700"><%= withdrawal.user_name %></td>
                    <td class="py-3 px-4 text-sm text-gray-600"><%= withdrawal.email %></td>
                    <td class="py-3 px-4 text-sm">
                        <span class="font-bold text-red-600">Rp <%= parseInt(withdrawal.amount).toLocaleString('id-ID') %></span>
                    </td>
                    <td class="py-3 px-4 text-sm text-gray-600 whitespace-nowrap">
                        <span><%= withdrawal.bank_name %></span>
                        <button onclick="copyToClipboard('<%= withdrawal.bank_name %>', 'Nama Bank')" class="text-gray-400 hover:text-gray-700 ml-1 p-0.5" title="Copy Bank">
                            <i class="fas fa-copy text-xs"></i>
                        </button>
                    </td>
                    <td class="py-3 px-4 text-sm text-gray-600 whitespace-nowrap">
                        <span class="font-mono text-xs bg-gray-100 px-1.5 py-0.5 rounded border border-gray-200"><%= withdrawal.bank_account_number %></span>
                        <button onclick="copyToClipboard('<%= withdrawal.bank_account_number %>', 'No. Rekening')" class="text-gray-400 hover:text-gray-700 ml-1 p-0.5" title="Copy Rekening">
                            <i class="fas fa-copy text-xs"></i>
                        </button>
                    </td>
                    <td class="py-3 px-4 text-sm text-gray-600 whitespace-nowrap">
                        <span><%= withdrawal.account_holder_name || withdrawal.bank_account_name %></span>
                        <button onclick="copyToClipboard('<%= withdrawal.account_holder_name || withdrawal.bank_account_name %>', 'Nama Pemilik Rekening')" class="text-gray-400 hover:text-gray-700 ml-1 p-0.5" title="Copy Nama Pemilik">
                            <i class="fas fa-copy text-xs"></i>
                        </button>
                    </td>
                    <td class="py-3 px-4 text-sm">
                        <% if (withdrawal.status === 'approved') { %>
                        <span class="px-2 py-1 bg-green-100 text-green-700 rounded text-xs font-semibold">
                            <i class="fas fa-check-circle"></i> Approved
                        </span>
                        <% } else if (withdrawal.status === 'rejected') { %>
                        <span class="px-2 py-1 bg-red-100 text-red-700 rounded text-xs font-semibold">
                            <i class="fas fa-times-circle"></i> Rejected
                        </span>
                        <% } else { %>
                        <span class="px-2 py-1 bg-yellow-100 text-yellow-700 rounded text-xs font-semibold">
                            <i class="fas fa-clock"></i> Pending
                        </span>
                        <% } %>
                    </td>
                    <td class="py-3 px-4 text-sm text-gray-600">
                        <%= new Date(withdrawal.created_at).toLocaleDateString('id-ID') %>
                        <br>
                        <span class="text-xs text-gray-500">
                            <%= new Date(withdrawal.created_at).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) %>
                        </span>
                    </td>
                    <td class="py-3 px-4 text-sm">
                        <% if (withdrawal.status === 'pending') { %>
                        <button onclick="approveWithdrawal(<%= withdrawal.id %>)"
                            class="bg-green-500 hover:bg-green-600 text-white px-3 py-1 rounded text-xs mr-2">
                            <i class="fas fa-check"></i> Approve
                        </button>
                        <button onclick="rejectWithdrawal(<%= withdrawal.id %>)"
                            class="bg-red-500 hover:bg-red-600 text-white px-3 py-1 rounded text-xs">
                            <i class="fas fa-times"></i> Reject
                        </button>
                        <% } else { %>
                        <span class="text-gray-400 text-xs">No actions</span>
                        <% } %>
                    </td>
                </tr>
                <% }); %>
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    <div class="mt-6 flex items-center justify-between border-t border-gray-200 pt-4">
        <div class="text-sm text-gray-600">
            Showing <%= ((currentPage - 1) * 20) + 1 %> to <%= Math.min(currentPage * 20, totalRecords) %> of <%= totalRecords %> records
        </div>
        <div class="flex gap-2">
            <% if (currentPage > 1) { %>
                <a href="?page=<%= currentPage - 1 %>" class="px-4 py-2 bg-gray-200 hover:bg-gray-300 rounded-lg text-sm font-semibold transition">Previous</a>
            <% } else { %>
                <span class="px-4 py-2 bg-gray-100 text-gray-400 rounded-lg text-sm font-semibold cursor-not-allowed">Previous</span>
            <% } %>

            <%
            const startPage = Math.max(1, currentPage - 2);
            const endPage = Math.min(totalPages, currentPage + 2);
            for (let i = startPage; i <= endPage; i++) { %>
                <% if (i === currentPage) { %>
                    <span class="px-4 py-2 bg-blue-600 text-white rounded-lg text-sm font-semibold"><%= i %></span>
                <% } else { %>
                    <a href="?page=<%= i %>" class="px-4 py-2 bg-gray-200 hover:bg-gray-300 rounded-lg text-sm font-semibold transition"><%= i %></a>
                <% } %>
            <% } %>

            <% if (currentPage < totalPages) { %>
                <a href="?page=<%= currentPage + 1 %>" class="px-4 py-2 bg-gray-200 hover:bg-gray-300 rounded-lg text-sm font-semibold transition">Next</a>
            <% } else { %>
                <span class="px-4 py-2 bg-gray-100 text-gray-400 rounded-lg text-sm font-semibold cursor-not-allowed">Next</span>
            <% } %>
        </div>
    </div>
</div>

<div id="toast-container" class="fixed top-4 right-4 z-50"></div>

<script>
async function approveWithdrawal(withdrawalId) {
    if (!confirm('Are you sure you want to approve this withdrawal?')) {
        return;
    }

    try {
        const response = await fetch('/api/admin/withdrawals/approve', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ withdrawalId })
        });

        const result = await response.json();
        if (result.success) {
            showToast(result.message, 'success');
            // DOM update handled by socket listener
        } else {
            showToast(result.message, 'error');
        }
    } catch (error) {
        showToast('Error approving withdrawal', 'error');
    }
}

async function rejectWithdrawal(withdrawalId) {
    if (!confirm('Are you sure you want to reject this withdrawal?')) {
        return;
    }

    try {
        const response = await fetch('/api/admin/withdrawals/reject', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ withdrawalId })
        });

        const result = await response.json();
        if (result.success) {
            showToast(result.message, 'success');
            // DOM update handled by socket listener
        } else {
            showToast(result.message, 'error');
        }
    } catch (error) {
        showToast('Error rejecting withdrawal', 'error');
    }
}

// Socket.IO Listener for real-time updates
if (typeof adminSocket !== 'undefined') {
    adminSocket.on('withdrawal-updated', (data) => {
        // Find the row
        const row = document.querySelector(`tr:has(button[onclick="approveWithdrawal(${data.id})"])`) ||
                    document.querySelector(`tr:has(button[onclick="rejectWithdrawal(${data.id})"])`);
        
        if (row) {
            // Update status badge
            const statusCell = row.querySelector('td:nth-child(6)');
            if (data.status === 'approved') {
                statusCell.innerHTML = '<span class="px-2 py-1 bg-green-100 text-green-700 rounded text-xs font-semibold"><i class="fas fa-check-circle"></i> Approved</span>';
            } else if (data.status === 'rejected') {
                statusCell.innerHTML = '<span class="px-2 py-1 bg-red-100 text-red-700 rounded text-xs font-semibold"><i class="fas fa-times-circle"></i> Rejected</span>';
            }

            // Remove action buttons
            const actionCell = row.querySelector('td:last-child');
            actionCell.innerHTML = '<span class="text-gray-400 text-xs">No actions</span>';
        }
    });
}
</script>

<%- include('partials/footer') %>
