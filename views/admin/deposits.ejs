<%- include('partials/header', { title: 'Deposits Management', page: 'deposits' }) %>

<h2 class="text-3xl font-bold text-gray-800 mb-8">Deposits Management</h2>

<div class="bg-white rounded-xl shadow-lg p-6">
    <div class="overflow-x-auto">
        <table class="w-full">
            <thead>
                <tr class="border-b border-gray-200">
                    <th class="text-left py-3 px-4 text-sm font-semibold text-gray-600">ID</th>
                    <th class="text-left py-3 px-4 text-sm font-semibold text-gray-600">User</th>
                    <th class="text-left py-3 px-4 text-sm font-semibold text-gray-600">Email</th>
                    <th class="text-left py-3 px-4 text-sm font-semibold text-gray-600">Amount</th>
                    <th class="text-left py-3 px-4 text-sm font-semibold text-gray-600">Unique Amount</th>
                    <th class="text-left py-3 px-4 text-sm font-semibold text-gray-600">Nama Pengirim</th>
                    <th class="text-left py-3 px-4 text-sm font-semibold text-gray-600">Bukti Transfer</th>
                    <th class="text-left py-3 px-4 text-sm font-semibold text-gray-600">Status</th>
                    <th class="text-left py-3 px-4 text-sm font-semibold text-gray-600">Admin Note</th>
                    <th class="text-left py-3 px-4 text-sm font-semibold text-gray-600">Created At</th>
                    <th class="text-left py-3 px-4 text-sm font-semibold text-gray-600">Actions</th>
                </tr>
            </thead>
            <tbody>
                <% deposits.forEach(deposit => { %>
                <tr class="border-b border-gray-100 hover:bg-gray-50 transition">
                    <td class="py-3 px-4 text-sm text-gray-600">#<%= deposit.id %></td>
                    <td class="py-3 px-4 text-sm font-semibold text-gray-700"><%= deposit.user_name %></td>
                    <td class="py-3 px-4 text-sm text-gray-600"><%= deposit.email %></td>
                    <td class="py-3 px-4 text-sm">
                        <span class="font-bold text-green-600">Rp <%= parseInt(deposit.amount).toLocaleString('id-ID') %></span>
                    </td>
                    <td class="py-3 px-4 text-sm">
                        <span class="font-bold text-green-600">Rp <span class="unique-amount" data-amount="<%= deposit.unique_amount %>"></span></span>
                    </td>
                    <td class="py-3 px-4 text-sm font-semibold text-gray-800">
                        <%= deposit.sender_name || '-' %>
                    </td>
                    <td class="py-3 px-4 text-sm">
                        <% if (deposit.proof_image) { %>
                        <button onclick="viewProofImage('<%= deposit.proof_image %>')"
                            class="bg-blue-500 hover:bg-blue-600 text-white px-3 py-1 rounded text-xs">
                            <i class="fas fa-image"></i> Lihat Bukti
                        </button>
                        <% } else { %>
                        <span class="text-gray-400 text-xs">No image</span>
                        <% } %>
                    </td>
                    <td class="py-3 px-4 text-sm">
                        <% if (deposit.status === 'approved') { %>
                        <span class="px-2 py-1 bg-green-100 text-green-700 rounded text-xs font-semibold">
                            <i class="fas fa-check-circle"></i> Approved
                        </span>
                        <% } else if (deposit.status === 'rejected') { %>
                        <span class="px-2 py-1 bg-red-100 text-red-700 rounded text-xs font-semibold">
                            <i class="fas fa-times-circle"></i> Rejected
                        </span>
                        <% } else if (deposit.status === 'initiated') { %>
                        <span class="px-2 py-1 bg-blue-100 text-blue-700 rounded text-xs font-semibold">
                            <i class="fas fa-hourglass-start"></i> Belum Upload
                        </span>
                        <% } else { %>
                        <span class="px-2 py-1 bg-yellow-100 text-yellow-700 rounded text-xs font-semibold">
                            <i class="fas fa-clock"></i> Pending
                        </span>
                        <% } %>
                    </td>
                    <td class="py-3 px-4 text-sm text-gray-600">
                        <%= deposit.admin_note || '-' %>
                    </td>
                    <td class="py-3 px-4 text-sm text-gray-600">
                        <%= new Date(deposit.created_at).toLocaleDateString('id-ID') %>
                        <br>
                        <span class="text-xs text-gray-500">
                            <%= new Date(deposit.created_at).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) %>
                        </span>
                    </td>
                    <td class="py-3 px-4 text-sm">
                        <% if (deposit.status === 'pending') { %>
                        <button onclick="approveDeposit(<%= deposit.id %>)"
                            class="bg-green-500 hover:bg-green-600 text-white px-3 py-1 rounded text-xs mr-2">
                            <i class="fas fa-check"></i> Approve
                        </button>
                        <button onclick="rejectDeposit(<%= deposit.id %>)"
                            class="bg-red-500 hover:bg-red-600 text-white px-3 py-1 rounded text-xs">
                            <i class="fas fa-times"></i> Reject
                        </button>
                        <% } else { %>
                        <span class="text-gray-400 text-xs">No actions</span>
                        <% } %>
                    </td>
                </tr>
                <% }); %>
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    <div class="mt-6 flex items-center justify-between border-t border-gray-200 pt-4">
        <div class="text-sm text-gray-600">
            Showing <%= ((currentPage - 1) * 20) + 1 %> to <%= Math.min(currentPage * 20, totalRecords) %> of <%= totalRecords %> records
        </div>
        <div class="flex gap-2">
            <% if (currentPage > 1) { %>
                <a href="?page=<%= currentPage - 1 %>" class="px-4 py-2 bg-gray-200 hover:bg-gray-300 rounded-lg text-sm font-semibold transition">Previous</a>
            <% } else { %>
                <span class="px-4 py-2 bg-gray-100 text-gray-400 rounded-lg text-sm font-semibold cursor-not-allowed">Previous</span>
            <% } %>

            <%
            const startPage = Math.max(1, currentPage - 2);
            const endPage = Math.min(totalPages, currentPage + 2);
            for (let i = startPage; i <= endPage; i++) { %>
                <% if (i === currentPage) { %>
                    <span class="px-4 py-2 bg-blue-600 text-white rounded-lg text-sm font-semibold"><%= i %></span>
                <% } else { %>
                    <a href="?page=<%= i %>" class="px-4 py-2 bg-gray-200 hover:bg-gray-300 rounded-lg text-sm font-semibold transition"><%= i %></a>
                <% } %>
            <% } %>

            <% if (currentPage < totalPages) { %>
                <a href="?page=<%= currentPage + 1 %>" class="px-4 py-2 bg-gray-200 hover:bg-gray-300 rounded-lg text-sm font-semibold transition">Next</a>
            <% } else { %>
                <span class="px-4 py-2 bg-gray-100 text-gray-400 rounded-lg text-sm font-semibold cursor-not-allowed">Next</span>
            <% } %>
        </div>
    </div>
</div>

<div id="toast-container" class="fixed top-4 right-4 z-50"></div>

<!-- Modal for Image Preview -->
<div id="imageModal" class="fixed inset-0 bg-black bg-opacity-75 hidden items-center justify-center z-50" onclick="closeImageModal()">
    <div class="relative max-w-4xl max-h-[90vh] p-4" onclick="event.stopPropagation()">
        <button onclick="closeImageModal()" class="absolute -top-10 right-0 text-white hover:text-gray-300 text-2xl font-bold">
            <i class="fas fa-times-circle"></i>
        </button>
        <img id="modalImage" src="" alt="Bukti Transfer" class="max-w-full max-h-[85vh] rounded-lg shadow-2xl">
    </div>
</div>

<script>
// Format amount: 100257 -> "100.257"
function formatUniqueAmount(amount) {
    const amountStr = amount.toString();
    if (amountStr.length <= 3) return amountStr;

    const lastThree = amountStr.slice(-3);
    const remaining = amountStr.slice(0, -3);
    return remaining.replace(/\B(?=(\d{3})+(?!\d))/g, '.') + '.' + lastThree;
}

// Format all unique amounts on page load
document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.unique-amount').forEach(el => {
        const amount = el.getAttribute('data-amount');
        el.textContent = formatUniqueAmount(amount);
    });
});

async function approveDeposit(depositId) {
    if (!confirm('Are you sure you want to approve this deposit?')) {
        return;
    }

    try {
        const response = await fetch('/api/admin/deposits/approve', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ depositId })
        });

        const result = await response.json();
        if (result.success) {
            showToast(result.message, 'success');
            // DOM update handled by socket listener
        } else {
            showToast(result.message, 'error');
        }
    } catch (error) {
        showToast('Error approving deposit', 'error');
    }
}

async function rejectDeposit(depositId) {
    if (!confirm('Are you sure you want to reject this deposit?')) {
        return;
    }

    try {
        const response = await fetch('/api/admin/deposits/reject', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ depositId })
        });

        const result = await response.json();
        if (result.success) {
            showToast(result.message, 'success');
            // DOM update handled by socket listener
        } else {
            showToast(result.message, 'error');
        }
    } catch (error) {
        showToast('Error rejecting deposit', 'error');
    }
}

function viewProofImage(filename) {
    const modal = document.getElementById('imageModal');
    const modalImage = document.getElementById('modalImage');
    modalImage.src = `/uploads/deposit-proofs/${filename}`;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
}

function closeImageModal() {
    const modal = document.getElementById('imageModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
}

// Socket.IO Listener for real-time updates
if (typeof adminSocket !== 'undefined') {
    adminSocket.on('deposit-updated', (data) => {
        // Find the row
        const row = document.querySelector(`tr:has(button[onclick="approveDeposit(${data.id})"])`) ||
                    document.querySelector(`tr:has(button[onclick="rejectDeposit(${data.id})"])`);
        
        if (row) {
            // Update status badge
            const statusCell = row.querySelector('td:nth-child(7)');
            if (data.status === 'approved') {
                statusCell.innerHTML = '<span class="px-2 py-1 bg-green-100 text-green-700 rounded text-xs font-semibold"><i class="fas fa-check-circle"></i> Approved</span>';
            } else if (data.status === 'rejected') {
                statusCell.innerHTML = '<span class="px-2 py-1 bg-red-100 text-red-700 rounded text-xs font-semibold"><i class="fas fa-times-circle"></i> Rejected</span>';
            }

            // Remove action buttons
            const actionCell = row.querySelector('td:last-child');
            actionCell.innerHTML = '<span class="text-gray-400 text-xs">No actions</span>';
        }
    });
}
</script>

<%- include('partials/footer') %>
