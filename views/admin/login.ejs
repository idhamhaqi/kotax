<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Portal Login - Kuotax</title>
    <link rel="icon" type="image/png" href="/images/icon.png">
    <link rel="stylesheet" href="/css/style.css?v=<%= Date.now() %>">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            background: #0f172a;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: system-ui, -apple-system, sans-serif;
        }
        .admin-login-card {
            background: #1e293b;
            border: 1px solid #334155;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            border-radius: 16px;
            width: 100%;
            max-width: 420px;
            padding: 36px 32px;
        }
        .admin-input {
            width: 100%;
            padding: 12px 16px 12px 42px;
            background: #0f172a;
            border: 1px solid #334155;
            border-radius: 10px;
            color: #f8fafc;
            font-size: 14px;
            outline: none;
            transition: all 0.2s;
        }
        .admin-input:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2);
        }
        .admin-btn {
            width: 100%;
            padding: 13px;
            border-radius: 10px;
            background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
            color: #ffffff;
            font-weight: 600;
            font-size: 15px;
            border: none;
            cursor: pointer;
            transition: all 0.2s;
        }
        .admin-btn:hover {
            background: linear-gradient(135deg, #1d4ed8 0%, #1e40af 100%);
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
        }
    </style>
</head>
<body>
    <div class="admin-login-card">
        <div class="text-center mb-8">
            <div class="w-16 h-16 bg-blue-600/20 text-blue-500 rounded-2xl flex items-center justify-center mx-auto mb-4 border border-blue-500/30">
                <i class="fas fa-user-shield text-2xl"></i>
            </div>
            <h1 class="text-white text-2xl font-bold tracking-tight">Admin Portal</h1>
            <p class="text-slate-400 text-xs mt-1">Otentikasi Pengelola Sistem</p>
        </div>

        <form id="adminLoginForm" class="space-y-5">
            <div>
                <label class="block text-slate-300 text-xs font-semibold mb-2 uppercase tracking-wider">Username / Email</label>
                <div class="relative">
                    <i class="fas fa-user absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 text-sm"></i>
                    <input type="text" name="username" required autocomplete="username"
                        class="admin-input" placeholder="Masukkan username admin">
                </div>
            </div>

            <div>
                <label class="block text-slate-300 text-xs font-semibold mb-2 uppercase tracking-wider">Password</label>
                <div class="relative">
                    <i class="fas fa-lock absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 text-sm"></i>
                    <input type="password" name="password" required autocomplete="current-password"
                        class="admin-input" placeholder="Masukkan password">
                </div>
            </div>

            <button type="submit" id="submitBtn" class="admin-btn">
                <i class="fas fa-lock-open mr-2"></i> Masuk ke Panel Admin
            </button>
        </form>

        <div class="mt-8 text-center border-t border-slate-700/60 pt-4">
            <p class="text-slate-500 text-xs">
                <i class="fas fa-shield-alt mr-1 text-blue-400"></i> Terenkripsi & Diproteksi
            </p>
        </div>
    </div>

    <div id="toast-container" class="fixed top-4 right-4 z-50"></div>
    <script src="/js/toast.js?v=<%= Date.now() %>"></script>
    <script>
    document.getElementById('adminLoginForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const form = e.target;
        const btn = document.getElementById('submitBtn');
        const origText = btn.innerHTML;
        
        btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> Memverifikasi...';
        btn.disabled = true;

        const formData = new FormData(form);
        const body = Object.fromEntries(formData);

        try {
            const res = await fetch('/api/admin/login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body)
            });

            const result = await res.json();
            if (result.success) {
                showToast(result.message, 'success');
                setTimeout(() => {
                    window.location.href = result.redirect || '/admin';
                }, 500);
            } else {
                showToast(result.message || 'Login gagal', 'error');
                btn.innerHTML = origText;
                btn.disabled = false;
            }
        } catch (err) {
            showToast('Kesalahan koneksi ke server', 'error');
            btn.innerHTML = origText;
            btn.disabled = false;
        }
    });
    </script>
</body>
</html>
