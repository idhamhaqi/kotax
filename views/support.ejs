<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tiket Bantuan - KUOTAX</title>
    <%- include('partials/pwa-head') %>
    <link rel="stylesheet" href="/css/style.css?v=7">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .glass {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.4);
        }
    </style>
</head>
<body class="bg-gradient-to-br from-emerald-50 via-green-50 to-teal-50 min-h-screen text-gray-800">
    <%- include('partials/sidebar', { page: 'support' }) %>

    <!-- MAIN CONTENT WRAPPER -->
    <div class="lg:ml-64 pb-24 lg:pb-12 min-h-screen">
        
        <!-- App Header Bar -->
        <div class="bg-white border-b border-gray-100 px-4 lg:px-8 py-4 sticky top-0 z-20 flex items-center justify-between shadow-xs">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-2xl bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold">
                    <i class="fas fa-headset text-lg"></i>
                </div>
                <div>
                    <h1 class="text-lg lg:text-xl font-black text-gray-800 tracking-tight">Tiket Bantuan</h1>
                    <p class="text-xs text-gray-500 font-medium">Layanan kendala & bantuan pelanggan Kuotax</p>
                </div>
            </div>
            <button id="btnOpenCreateModal" onclick="openCreateModal()" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-4 py-2.5 rounded-xl text-xs sm:text-sm flex items-center gap-2 shadow-md hover:shadow-emerald-600/20 transition">
                <i class="fas fa-plus"></i> <span>Buat Tiket</span>
            </button>
        </div>

        <div class="p-4 lg:p-8 max-w-5xl mx-auto space-y-6">

            <!-- Anti-Spam Active Ticket Warning Banner (Hidden by default) -->
            <div id="activeTicketBanner" class="hidden bg-amber-50 border border-amber-200 rounded-2xl p-4 flex items-start gap-3 text-amber-800 shadow-sm">
                <div class="w-9 h-9 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center shrink-0 mt-0.5 font-bold">
                    <i class="fas fa-exclamation-triangle"></i>
                </div>
                <div class="flex-1 text-xs sm:text-sm">
                    <p class="font-extrabold text-amber-900">Tiket Aktif Dalam Penanganan</p>
                    <p class="mt-0.5 text-amber-700">Anda sedang memiliki 1 tiket aktif yang belum ditutup (<span id="activeTicketCodeText" class="font-mono font-bold"></span>). Harap selesaikan kendala pada tiket tersebut sebelum membuat tiket baru.</p>
                </div>
            </div>

            <!-- Ticket List Container -->
            <div class="bg-white rounded-3xl p-5 sm:p-6 shadow-sm border border-gray-100">
                <div class="flex items-center justify-between mb-4 pb-3 border-b border-gray-100">
                    <h2 class="text-sm font-bold text-gray-800 uppercase tracking-wide flex items-center gap-2">
                        <i class="fas fa-list-alt text-emerald-600"></i> Daftar Tiket Saya
                    </h2>
                    <button onclick="loadUserTickets()" class="text-xs text-emerald-600 hover:text-emerald-700 font-semibold flex items-center gap-1">
                        <i class="fas fa-sync-alt"></i> Refresh
                    </button>
                </div>

                <div id="ticketListLoading" class="text-center py-12 text-gray-400">
                    <i class="fas fa-circle-notch fa-spin text-2xl mb-2 text-emerald-600"></i>
                    <p class="text-xs font-medium">Memuat daftar tiket...</p>
                </div>

                <div id="ticketListEmpty" class="hidden text-center py-12 px-4">
                    <div class="w-16 h-16 bg-emerald-50 text-emerald-600 rounded-full flex items-center justify-center mx-auto mb-3">
                        <i class="fas fa-ticket-alt text-2xl"></i>
                    </div>
                    <h3 class="text-base font-bold text-gray-700 mb-1">Belum Ada Tiket Bantuan</h3>
                    <p class="text-xs text-gray-500 max-w-sm mx-auto mb-4">Jika Anda mengalami kendala transaksi atau deposit, klik tombol "Buat Tiket" di atas untuk menghubungi Admin.</p>
                </div>

                <div id="ticketListContainer" class="hidden space-y-3">
                    <!-- Ticket Items will be injected here -->
                </div>
            </div>

        </div>
    </div>

    <!-- ============================================ -->
    <!-- MODAL 1: BUAT TIKET BARU -->
    <!-- ============================================ -->
    <div id="createTicketModal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-xs flex items-center justify-center p-4 hidden">
        <div class="bg-white rounded-3xl max-w-lg w-full p-6 shadow-2xl relative border border-gray-100 max-h-[90vh] overflow-y-auto">
            <div class="flex items-center justify-between pb-4 mb-4 border-b border-gray-100">
                <div class="flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold">
                        <i class="fas fa-plus"></i>
                    </div>
                    <h3 class="text-base font-bold text-gray-800">Buat Tiket Bantuan Baru</h3>
                </div>
                <button onclick="closeCreateModal()" class="text-gray-400 hover:text-gray-600 p-1">
                    <i class="fas fa-times text-lg"></i>
                </button>
            </div>

            <form id="createTicketForm" class="space-y-4">
                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Kategori Kendala</label>
                    <select name="category" required class="w-full bg-gray-50 border border-gray-200 rounded-xl px-3 py-2.5 text-xs sm:text-sm font-medium focus:bg-white focus:border-emerald-500 outline-none">
                        <option value="Deposit">Deposit Saldo</option>
                        <option value="PPOB/Fill Order">PPOB / Fill Order / Kuota</option>
                        <option value="Penarikan/Withdraw">Penarikan Saldo (Withdraw)</option>
                        <option value="Akun">Akun & Keamanan</option>
                        <option value="Lainnya">Lain-lain</option>
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Subjek Kendala</label>
                    <input type="text" name="subject" required placeholder="Contoh: Deposit Saldo Rp 100.000 Belum Masuk" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-3 py-2.5 text-xs sm:text-sm font-medium focus:bg-white focus:border-emerald-500 outline-none">
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Prioritas</label>
                    <select name="priority" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-3 py-2.5 text-xs sm:text-sm font-medium focus:bg-white focus:border-emerald-500 outline-none">
                        <option value="normal">Normal</option>
                        <option value="high">Tinggi (Penting)</option>
                        <option value="low">Rendah</option>
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Pesan / Penjelasan Kendala</label>
                    <textarea name="message" rows="4" required placeholder="Jelaskan kendala Anda secara detail agar tim admin dapat membantu dengan cepat..." class="w-full bg-gray-50 border border-gray-200 rounded-xl p-3 text-xs sm:text-sm font-medium focus:bg-white focus:border-emerald-500 outline-none"></textarea>
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Lampiran Foto / Screenshot (Opsional)</label>
                    <input type="file" name="attachment" accept="image/*" class="w-full text-xs text-gray-500 file:mr-3 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-emerald-50 file:text-emerald-700 hover:file:bg-emerald-100">
                    <p class="text-[10px] text-gray-400 mt-1">Format: JPG, PNG, WebP (Maks 5MB)</p>
                </div>

                <div class="pt-3 flex gap-2">
                    <button type="button" onclick="closeCreateModal()" class="w-1/2 py-2.5 rounded-xl border border-gray-200 text-gray-600 font-bold text-xs sm:text-sm hover:bg-gray-50">Batal</button>
                    <button type="submit" id="btnSubmitCreate" class="w-1/2 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs sm:text-sm shadow-md transition">Kirim Tiket</button>
                </div>
            </form>
        </div>
    </div>

    <!-- ============================================ -->
    <!-- MODAL 2: DETAIL TIKET & CHAT THREAD -->
    <!-- ============================================ -->
    <div id="detailTicketModal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-xs flex items-center justify-center p-2 sm:p-4 hidden">
        <div class="bg-white rounded-3xl max-w-2xl w-full p-4 sm:p-6 shadow-2xl relative border border-gray-100 max-h-[95vh] flex flex-col">
            <!-- Header -->
            <div class="flex items-center justify-between pb-3 mb-3 border-b border-gray-100 shrink-0">
                <div>
                    <div class="flex items-center gap-2">
                        <span id="dtCode" class="font-mono text-xs font-bold bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded-md"></span>
                        <span id="dtStatusBadge"></span>
                    </div>
                    <h3 id="dtSubject" class="text-sm sm:text-base font-bold text-gray-800 mt-1 line-clamp-1"></h3>
                </div>
                <button onclick="closeDetailModal()" class="text-gray-400 hover:text-gray-600 p-1">
                    <i class="fas fa-times text-lg"></i>
                </button>
            </div>

            <!-- Messages Thread Area -->
            <div id="threadMessagesContainer" class="flex-1 overflow-y-auto space-y-3 p-2 bg-gray-50 rounded-2xl mb-3 border border-gray-100 min-h-[250px] max-h-[450px]">
                <!-- Thread messages rendered here -->
            </div>

            <!-- Reply Form Area (Disabled if Closed) -->
            <div id="replyAreaContainer" class="shrink-0 pt-2 border-t border-gray-100">
                <form id="replyTicketForm" class="space-y-2">
                    <input type="hidden" id="dtTicketId" value="">
                    
                    <div class="relative">
                        <textarea id="replyMessageInput" rows="2" required placeholder="Tulis balasan Anda..." class="w-full bg-gray-50 border border-gray-200 rounded-xl p-3 pr-12 text-xs sm:text-sm outline-none focus:bg-white focus:border-emerald-500"></textarea>
                    </div>

                    <div class="flex items-center justify-between gap-2">
                        <div class="flex-1">
                            <input type="file" id="replyAttachmentInput" accept="image/*" class="w-full text-[11px] text-gray-500 file:mr-2 file:py-1 file:px-3 file:rounded-lg file:border-0 file:text-[11px] file:font-bold file:bg-gray-100 file:text-gray-700 hover:file:bg-gray-200">
                        </div>
                        <div class="flex items-center gap-2">
                            <button type="button" onclick="closeUserTicket()" class="px-3 py-2 bg-red-50 text-red-600 hover:bg-red-100 border border-red-200 rounded-xl text-xs font-bold transition" title="Tandai Masalah Selesai">
                                <i class="fas fa-check-circle"></i> Selesai
                            </button>
                            <button type="submit" id="btnSubmitReply" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-bold shadow-md transition">
                                <i class="fas fa-paper-plane"></i> Kirim
                            </button>
                        </div>
                    </div>
                </form>
            </div>

            <div id="ticketClosedNotice" class="hidden p-3 bg-gray-100 rounded-xl text-center text-xs text-gray-500 font-semibold border border-gray-200">
                🔒 Tiket ini telah ditutup. Terima kasih telah menghubungi Kuotax Support.
            </div>
        </div>
    </div>

    <div id="toast-container" class="fixed top-4 right-4 z-50"></div>

    <!-- Socket.IO Client -->
    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/toast.js?v=<%= Date.now() %>"></script>

    <script>
    let userSocket = null;
    let currentUserTickets = [];
    let currentActiveTicketCode = null;

    document.addEventListener('DOMContentLoaded', () => {
        // Socket.IO registration
        if (typeof io !== 'undefined') {
            userSocket = io();
            userSocket.on('user-ticket-reply', (data) => {
                showToast(`💬 Admin membalas tiket Anda (${data.ticketCode})`, 'info');
                loadUserTickets();
                const currentModalTicketId = document.getElementById('dtTicketId').value;
                if (currentModalTicketId == data.ticketId) {
                    openTicketDetail(data.ticketId);
                }
            });
        }

        loadUserTickets();
    });

    async function loadUserTickets() {
        const loading = document.getElementById('ticketListLoading');
        const empty = document.getElementById('ticketListEmpty');
        const container = document.getElementById('ticketListContainer');
        const banner = document.getElementById('activeTicketBanner');
        const btnCreate = document.getElementById('btnOpenCreateModal');

        loading.classList.remove('hidden');
        empty.classList.add('hidden');
        container.classList.add('hidden');

        try {
            const response = await fetch('/api/support');
            const data = await response.json();

            loading.classList.add('hidden');

            if (data.success) {
                currentUserTickets = data.tickets;
                currentActiveTicketCode = data.activeTicketCode;

                if (data.hasActiveTicket) {
                    banner.classList.remove('hidden');
                    document.getElementById('activeTicketCodeText').textContent = data.activeTicketCode;
                    btnCreate.disabled = true;
                    btnCreate.classList.add('opacity-50', 'cursor-not-allowed');
                    btnCreate.title = 'Selesaikan tiket aktif sebelum membuat tiket baru';
                } else {
                    banner.classList.add('hidden');
                    btnCreate.disabled = false;
                    btnCreate.classList.remove('opacity-50', 'cursor-not-allowed');
                    btnCreate.title = 'Buat Tiket Baru';
                }

                if (currentUserTickets.length === 0) {
                    empty.classList.remove('hidden');
                } else {
                    container.innerHTML = currentUserTickets.map(t => renderTicketCard(t)).join('');
                    container.classList.remove('hidden');
                }
            }
        } catch (error) {
            console.error('Load tickets error:', error);
            loading.classList.add('hidden');
            showToast('Gagal memuat daftar tiket', 'error');
        }
    }

    function renderTicketCard(t) {
        let badgeHtml = '';
        if (t.status === 'open') {
            badgeHtml = `<span class="px-2.5 py-1 bg-amber-100 text-amber-800 border border-amber-300 rounded-full text-[11px] font-bold"><i class="fas fa-clock mr-1"></i> Menunggu Admin</span>`;
        } else if (t.status === 'answered') {
            badgeHtml = `<span class="px-2.5 py-1 bg-blue-100 text-blue-800 border border-blue-300 rounded-full text-[11px] font-bold"><i class="fas fa-reply mr-1"></i> Dibalas Admin</span>`;
        } else {
            badgeHtml = `<span class="px-2.5 py-1 bg-emerald-100 text-emerald-800 border border-emerald-300 rounded-full text-[11px] font-bold"><i class="fas fa-check-circle mr-1"></i> Selesai</span>`;
        }

        const dateStr = new Date(t.updated_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });

        return `
        <div onclick="openTicketDetail(${t.id})" class="p-4 rounded-2xl bg-gray-50 hover:bg-emerald-50/60 border border-gray-200/80 hover:border-emerald-200 transition cursor-pointer flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div>
                <div class="flex items-center gap-2 mb-1">
                    <span class="font-mono text-xs font-bold text-gray-500 bg-white px-2 py-0.5 rounded border border-gray-200">${t.ticket_code}</span>
                    <span class="text-[11px] font-semibold text-purple-700 bg-purple-50 px-2 py-0.5 rounded border border-purple-100">${t.category}</span>
                    ${badgeHtml}
                </div>
                <h4 class="text-sm font-bold text-gray-800 line-clamp-1">${t.subject}</h4>
                <p class="text-[11px] text-gray-400 mt-0.5">Terakhir diperbarui: ${dateStr}</p>
            </div>
            <div class="flex items-center gap-2 text-xs font-bold text-emerald-600 shrink-0">
                <span>Lihat Percakapan</span>
                <i class="fas fa-chevron-right text-xs"></i>
            </div>
        </div>
        `;
    }

    function openCreateModal() {
        if (currentActiveTicketCode) {
            showToast(`Anda masih memiliki tiket aktif (${currentActiveTicketCode}). Selesaikan tiket aktif terlebih dahulu.`, 'error');
            return;
        }
        document.getElementById('createTicketModal').classList.remove('hidden');
    }

    function closeCreateModal() {
        document.getElementById('createTicketModal').classList.add('hidden');
        document.getElementById('createTicketForm').reset();
    }

    document.getElementById('createTicketForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const form = e.target;
        const btn = document.getElementById('btnSubmitCreate');
        const origText = btn.innerHTML;

        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Mengirim...';

        const formData = new FormData(form);

        try {
            const res = await fetch('/api/support/create', {
                method: 'POST',
                body: formData
            });

            const data = await res.json();
            btn.disabled = false;
            btn.innerHTML = origText;

            if (data.success) {
                showToast(data.message, 'success');
                closeCreateModal();
                loadUserTickets();
            } else {
                showToast(data.message, 'error');
            }
        } catch (err) {
            btn.disabled = false;
            btn.innerHTML = origText;
            showToast('Gagal mengirim tiket', 'error');
        }
    });

    async function openTicketDetail(ticketId) {
        document.getElementById('dtTicketId').value = ticketId;
        const modal = document.getElementById('detailTicketModal');
        const thread = document.getElementById('threadMessagesContainer');

        thread.innerHTML = '<div class="text-center py-8 text-gray-400 text-xs"><i class="fas fa-spinner fa-spin text-lg mb-1"></i> Memuat pesan...</div>';
        modal.classList.remove('hidden');

        try {
            const res = await fetch(`/api/support/${ticketId}`);
            const data = await res.json();

            if (data.success) {
                const t = data.ticket;
                document.getElementById('dtCode').textContent = t.ticket_code;
                document.getElementById('dtSubject').textContent = t.subject;

                let badgeHtml = '';
                if (t.status === 'open') {
                    badgeHtml = `<span class="px-2 py-0.5 bg-amber-100 text-amber-800 rounded text-[11px] font-bold">Menunggu Admin</span>`;
                } else if (t.status === 'answered') {
                    badgeHtml = `<span class="px-2 py-0.5 bg-blue-100 text-blue-800 rounded text-[11px] font-bold">Dibalas Admin</span>`;
                } else {
                    badgeHtml = `<span class="px-2 py-0.5 bg-emerald-100 text-emerald-800 rounded text-[11px] font-bold">Selesai</span>`;
                }
                document.getElementById('dtStatusBadge').innerHTML = badgeHtml;

                if (t.status === 'closed') {
                    document.getElementById('replyAreaContainer').classList.add('hidden');
                    document.getElementById('ticketClosedNotice').classList.remove('hidden');
                } else {
                    document.getElementById('replyAreaContainer').classList.remove('hidden');
                    document.getElementById('ticketClosedNotice').classList.add('hidden');
                }

                // Render Messages
                thread.innerHTML = data.messages.map(m => {
                    const isUser = m.sender_type === 'user';
                    const timeStr = new Date(m.created_at).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' });

                    return `
                    <div class="flex flex-col ${isUser ? 'items-end' : 'items-start'}">
                        <div class="text-[10px] font-bold text-gray-400 mb-0.5 px-1">${isUser ? 'Saya' : '📌 Admin Kuotax'} • ${timeStr}</div>
                        <div class="max-w-[85%] rounded-2xl p-3 text-xs sm:text-sm ${isUser ? 'bg-emerald-600 text-white rounded-tr-none' : 'bg-white text-gray-800 border border-gray-200 rounded-tl-none shadow-xs'}">
                            <p class="whitespace-pre-line">${m.message}</p>
                            ${m.attachment_url ? `
                            <div class="mt-2 pt-2 border-t ${isUser ? 'border-emerald-500' : 'border-gray-100'}">
                                <a href="${m.attachment_url}" target="_blank" class="block rounded-lg overflow-hidden border border-black/10">
                                    <img src="${m.attachment_url}" alt="Attachment" class="max-h-40 w-auto object-cover">
                                </a>
                            </div>` : ''}
                        </div>
                    </div>
                    `;
                }).join('');

                thread.scrollTop = thread.scrollHeight;
            }
        } catch (err) {
            console.error('Fetch detail error:', err);
            showToast('Gagal memuat percakapan tiket', 'error');
        }
    }

    function closeDetailModal() {
        document.getElementById('detailTicketModal').classList.add('hidden');
        document.getElementById('replyTicketForm').reset();
    }

    document.getElementById('replyTicketForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const ticketId = document.getElementById('dtTicketId').value;
        const message = document.getElementById('replyMessageInput').value.trim();
        const fileInput = document.getElementById('replyAttachmentInput');
        const btn = document.getElementById('btnSubmitReply');

        if (!message) return;

        btn.disabled = true;
        const formData = new FormData();
        formData.append('message', message);
        if (fileInput.files[0]) {
            formData.append('attachment', fileInput.files[0]);
        }

        try {
            const res = await fetch(`/api/support/${ticketId}/reply`, {
                method: 'POST',
                body: formData
            });

            const data = await res.json();
            btn.disabled = false;

            if (data.success) {
                document.getElementById('replyMessageInput').value = '';
                fileInput.value = '';
                openTicketDetail(ticketId);
                loadUserTickets();
            } else {
                showToast(data.message, 'error');
            }
        } catch (err) {
            btn.disabled = false;
            showToast('Gagal mengirim balasan', 'error');
        }
    });

    async function closeUserTicket() {
        const ticketId = document.getElementById('dtTicketId').value;
        if (!confirm('Tandai kendala ini sudah SELESAI dan tutup tiket?')) return;

        try {
            const res = await fetch(`/api/support/${ticketId}/close`, { method: 'POST' });
            const data = await res.json();
            if (data.success) {
                showToast('Tiket berhasil ditutup', 'success');
                openTicketDetail(ticketId);
                loadUserTickets();
            }
        } catch (err) {
            showToast('Gagal menutup tiket', 'error');
        }
    }
    </script>
</body>
</html>
