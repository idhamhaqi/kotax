<!-- PWA Configuration -->
<link rel="manifest" href="/manifest.json">

<!-- Theme Color -->
<meta name="theme-color" content="#10b981">
<meta name="msapplication-TileColor" content="#10b981">

<!-- Apple Touch Icon -->
<link rel="apple-touch-icon" href="/icons/android-launchericon-144-144.png">
<link rel="apple-touch-icon" sizes="144x144" href="/icons/android-launchericon-144-144.png">
<link rel="apple-touch-icon" sizes="512x512" href="/icons/android-launchericon-512-512.png">

<!-- Mobile Web App Meta Tags -->
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="KUOTAX">

<!-- Splash Screen iOS -->
<link rel="apple-touch-startup-image" href="/icons/android-launchericon-512-512.png">

<!-- Favicon -->
<link rel="icon" type="image/png" sizes="72x72" href="/icons/android-launchericon-72-72.png">
<link rel="icon" type="image/png" sizes="32x32" href="/icons/android-launchericon-72-72.png">
<link rel="shortcut icon" href="/icons/android-launchericon-72-72.png">

<!-- Windows Tiles -->
<meta name="msapplication-config" content="none">
<meta name="msapplication-TileImage" content="/icons/android-launchericon-144-144.png">

<% if (typeof googleAnalyticsScript !== 'undefined' && googleAnalyticsScript) { %>
<!-- Google Analytics & Public Tracking Script (Admin Configured) -->
<%- googleAnalyticsScript %>
<% } %>
