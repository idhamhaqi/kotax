<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Referral - KUOTAX</title>
    <%- include('partials/pwa-head') %>
    <link rel="stylesheet" href="/css/style.css?v=6">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .glass {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.3);
        }
        @media (max-width: 767px) {
            #referralsTable td:nth-child(2), #contentReferrals thead th:nth-child(2) { display: none; }
            #bonusesTable td:nth-child(5), #contentBonuses thead th:nth-child(5) { display: none; }
        }
    </style>
</head>
<body class="bg-gradient-to-br from-emerald-50 via-green-50 to-teal-50 min-h-screen">
    <%- include('partials/sidebar', { page: 'referral' }) %>

    <!-- ============================================ -->
    <!-- MOBILE LAYOUT (visible only on < lg screens) -->
    <!-- ============================================ -->
    <div class="lg:hidden bg-[#f8fafb] min-h-screen pb-24">
        <!-- App Bar -->
        <div class="bg-white border-b border-gray-100 px-4 py-4 sticky top-0 z-20 flex items-center justify-between">
            <h1 class="text-lg font-bold text-gray-800 tracking-tight">Referral</h1>
            <div class="w-8 h-8 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center">
                <i class="fas fa-users text-sm"></i>
            </div>
        </div>

        <div class="p-4">
            <!-- Referral Link -->
            <div class="bg-white rounded-2xl p-5 shadow-[0_2px_10px_rgba(0,0,0,0.03)] border border-gray-100 mb-4">
                <h3 class="text-sm font-bold text-gray-800 mb-3 px-1">Link Referral Anda</h3>
                <div class="flex gap-2">
                    <input type="text" id="referralLinkMobile" readonly
                        class="flex-1 px-4 py-3.5 rounded-xl bg-gray-50 border-transparent outline-none text-xs font-medium text-gray-600">
                    <button onclick="copyReferral('referralLinkMobile')"
                        class="px-5 rounded-xl bg-emerald-600 text-white font-bold hover:bg-emerald-700 transition flex items-center justify-center">
                        <i class="fas fa-copy"></i>
                    </button>
                </div>
            </div>

            <!-- Stats -->
            <div class="grid grid-cols-3 gap-3 mb-6">
                <div class="bg-white border border-gray-100 rounded-2xl p-4 shadow-sm">
                    <div class="w-8 h-8 rounded-full bg-yellow-50 text-yellow-600 flex items-center justify-center mb-2">
                        <i class="fas fa-coins text-sm"></i>
                    </div>
                    <p class="text-[10px] text-gray-400 font-medium mb-0.5">Total Bonus</p>
                    <p id="totalBonusMobile" class="text-sm font-bold text-gray-800">Rp 0</p>
                </div>
                <div class="bg-white border border-gray-100 rounded-2xl p-4 shadow-sm">
                    <div class="w-8 h-8 rounded-full bg-teal-50 text-teal-600 flex items-center justify-center mb-2">
                        <i class="fas fa-handshake text-sm"></i>
                    </div>
                    <p class="text-[10px] text-gray-400 font-medium mb-0.5">Bonus Fill Order</p>
                    <p id="fillOrderBonusMobile" class="text-sm font-bold text-gray-800">Rp 0</p>
                </div>
                <div class="bg-white border border-gray-100 rounded-2xl p-4 shadow-sm">
                    <div class="w-8 h-8 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center mb-2">
                        <i class="fas fa-users text-sm"></i>
                    </div>
                    <p class="text-[10px] text-gray-400 font-medium mb-0.5">Total Referral</p>
                    <p id="totalReferralsMobile" class="text-sm font-bold text-gray-800">0</p>
                </div>
            </div>

            <!-- Tabs -->
            <div class="flex bg-white rounded-xl p-1 shadow-sm border border-gray-100 mb-4">
                <button id="tabReferralsMobile" onclick="switchTabMobile('referrals')" class="flex-1 py-2 text-xs font-bold rounded-lg transition text-emerald-600 bg-emerald-50">Daftar Referral</button>
                <button id="tabBonusesMobile" onclick="switchTabMobile('bonuses')" class="flex-1 py-2 text-xs font-bold rounded-lg transition text-gray-500 hover:bg-gray-50">Riwayat Bonus</button>
            </div>

            <!-- Content Referrals -->
            <div id="contentReferralsMobile" class="space-y-3">
                <div id="referralsListMobile"></div>
                
                <div id="emptyReferralsMobile" class="hidden bg-white rounded-2xl p-8 text-center border border-gray-100">
                    <div class="w-12 h-12 bg-gray-50 rounded-full flex items-center justify-center mx-auto mb-3">
                        <i class="fas fa-users text-gray-300 text-xl"></i>
                    </div>
                    <p class="text-gray-400 text-xs font-medium">Belum ada referral</p>
                </div>
                
                <div id="loadMoreReferralsMobile" class="hidden mt-4 text-center">
                    <button onclick="loadMoreReferrals()" class="px-5 py-2 rounded-full bg-white border border-gray-200 text-gray-600 text-xs font-semibold shadow-sm">Muat Lebih Banyak</button>
                </div>
            </div>

            <!-- Content Bonuses -->
            <div id="contentBonusesMobile" class="hidden space-y-3">
                <div id="bonusesListMobile"></div>
                
                <div id="emptyBonusesMobile" class="hidden bg-white rounded-2xl p-8 text-center border border-gray-100">
                    <div class="w-12 h-12 bg-gray-50 rounded-full flex items-center justify-center mx-auto mb-3">
                        <i class="fas fa-inbox text-gray-300 text-xl"></i>
                    </div>
                    <p class="text-gray-400 text-xs font-medium">Belum ada bonus</p>
                </div>
                
                <div id="loadMoreBonusesMobile" class="hidden mt-4 text-center">
                    <button onclick="loadMoreBonuses()" class="px-5 py-2 rounded-full bg-white border border-gray-200 text-gray-600 text-xs font-semibold shadow-sm">Muat Lebih Banyak</button>
                </div>
            </div>
        </div>
    </div>

    <!-- ============================================ -->
    <!-- DESKTOP LAYOUT (visible only on >= lg screens) -->
    <!-- ============================================ -->
    <div class="hidden lg:block lg:ml-64 p-8 pb-8">
        <div class="mb-5 lg:mb-8">
            <h1 class="text-2xl lg:text-3xl font-bold text-gray-800 mb-2">Program Referral</h1>
            <p class="text-gray-600">Ajak teman dan dapatkan bonus otomatis</p>
        </div>

        <!-- Referral Link -->
        <div class="glass rounded-2xl p-4 lg:p-6 shadow-lg mb-5 lg:mb-8">
            <h3 class="text-lg font-bold text-gray-800 mb-4">
                <i class="fas fa-share-alt text-emerald-600"></i> Link Referral Anda
            </h3>
            <div class="flex gap-2">
                <input type="text" id="referralLinkDesktop" readonly
                    class="flex-1 px-4 py-3 rounded-lg bg-white/70 border border-gray-300 text-sm">
                <button onclick="copyReferral('referralLinkDesktop')"
                    class="px-6 py-3 rounded-lg bg-gradient-to-r from-emerald-600 to-green-600 text-white font-semibold hover:from-emerald-700 hover:to-green-700 transition shadow-lg">
                    <i class="fas fa-copy"></i> Copy
                </button>
            </div>
        </div>

        <!-- Bonus Stats -->
        <div class="grid grid-cols-3 gap-4 mb-8">
            <div class="glass rounded-2xl p-3 lg:p-4 shadow-lg">
                <div class="flex items-center justify-between mb-2">
                    <i class="fas fa-coins text-yellow-600 text-2xl"></i>
                </div>
                <p class="text-sm text-gray-600 mb-1">Total Bonus</p>
                <p id="totalBonusDesktop" class="text-xl md:text-2xl font-bold text-gray-800">Rp 0</p>
            </div>

            <div class="glass rounded-2xl p-3 lg:p-4 shadow-lg">
                <div class="flex items-center justify-between mb-2">
                    <i class="fas fa-handshake text-emerald-600 text-2xl"></i>
                </div>
                <p class="text-sm text-gray-600 mb-1">Bonus Eksekusi (Fill Order)</p>
                <p id="fillOrderBonusDesktop" class="text-xl md:text-2xl font-bold text-gray-800">Rp 0</p>
            </div>

            <div class="glass rounded-2xl p-3 lg:p-4 shadow-lg">
                <div class="flex items-center justify-between mb-2">
                    <i class="fas fa-users text-emerald-600 text-2xl"></i>
                </div>
                <p class="text-sm text-gray-600 mb-1">Total Referral</p>
                <p id="totalReferralsDesktop" class="text-xl md:text-2xl font-bold text-gray-800">0</p>
            </div>
        </div>

        <!-- Bonus Scheme Info -->
        <div class="glass rounded-2xl p-4 lg:p-6 shadow-lg mb-5 lg:mb-8">
            <h3 class="text-lg font-bold text-gray-800 mb-4">
                <i class="fas fa-gift text-emerald-600"></i> Skema Bonus Referral Direct (1 Level)
            </h3>
            <div class="max-w-md mx-auto bg-gradient-to-br from-emerald-50 to-emerald-100 rounded-xl p-5 border border-emerald-200 text-center shadow-sm">
                <span class="block text-xs font-bold text-emerald-700 uppercase tracking-wider mb-1">Bonus Referral Direct</span>
                <span class="text-3xl font-extrabold text-emerald-800">10%</span>
                <p class="text-xs font-semibold text-emerald-600 mt-1">Dihitung dari Profit Bersih setiap transaksi order downline langsung Anda</p>
            </div>

            <!-- Example Calculation -->
            <div class="mt-6 p-4 bg-gradient-to-r from-emerald-50 to-green-50 rounded-xl border border-emerald-200">
                <h4 class="font-bold text-emerald-800 mb-2 flex items-center gap-2 text-sm">
                    <i class="fas fa-calculator"></i> Contoh Perhitungan Komisi Referral (Fill Order)
                </h4>
                <p class="text-xs text-gray-600 leading-relaxed">
                    Setiap kali downline langsung (Level 1) Anda mengeksekusi orderan dengan profit **Rp 10.000**, Anda otomatis mendapatkan komisi referral **Rp 1.000 (10%)** yang masuk langsung ke Saldo Utama Anda.
                </p>
            </div>
        </div>

        <!-- Tabs -->
        <div class="glass rounded-2xl p-4 lg:p-6 shadow-lg">
            <div class="flex gap-2 lg:gap-4 mb-6 border-b border-gray-200">
                <button id="tabReferrals" onclick="switchTabDesktop('referrals')"
                    class="tab-btn flex-1 px-2 lg:px-4 py-3 text-sm lg:text-base font-semibold transition border-b-2 border-emerald-600 text-emerald-600">
                    Daftar Referral
                </button>
                <button id="tabBonuses" onclick="switchTabDesktop('bonuses')"
                    class="tab-btn flex-1 px-2 lg:px-4 py-3 text-sm lg:text-base font-semibold transition border-b-2 border-transparent text-gray-600 hover:text-gray-800">
                    Riwayat Bonus
                </button>
            </div>

            <!-- Referrals Table -->
            <div id="contentReferralsDesktop">
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead>
                            <tr class="border-b border-gray-200">
                                <th class="text-left py-3 px-2 text-sm font-semibold text-gray-600">Nama</th>
                                <th class="text-left py-3 px-2 text-sm font-semibold text-gray-600">Email</th>
                                <th class="text-left py-3 px-2 text-sm font-semibold text-gray-600">Bergabung</th>
                                <th class="text-left py-3 px-2 text-sm font-semibold text-gray-600">Total Bonus</th>
                            </tr>
                        </thead>
                        <tbody id="referralsTableDesktop"></tbody>
                    </table>
                </div>
                <div id="emptyReferralsDesktop" class="hidden text-center py-12">
                    <i class="fas fa-users text-gray-300 text-6xl mb-4"></i>
                    <p class="text-gray-500">Belum ada referral</p>
                </div>
                <!-- Pagination Referrals (Desktop) -->
                <div id="paginationContainerReferralsDesktop" class="hidden mt-6 flex items-center justify-between border-t border-gray-150 pt-4">
                    <div class="text-sm text-gray-600" id="paginationInfoReferralsDesktop"></div>
                    <div class="flex gap-1" id="paginationPagesReferralsDesktop"></div>
                </div>
            </div>

            <!-- Bonuses Table -->
            <div id="contentBonusesDesktop" class="hidden">
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead>
                            <tr class="border-b border-gray-200">
                                <th class="text-left py-3 px-2 text-sm font-semibold text-gray-600">Tanggal</th>
                                <th class="text-left py-3 px-2 text-sm font-semibold text-gray-600">Dari</th>
                                <th class="text-left py-3 px-2 text-sm font-semibold text-gray-600">Tipe</th>
                                <th class="text-left py-3 px-2 text-sm font-semibold text-gray-600">Bonus</th>
                                <th class="text-left py-3 px-2 text-sm font-semibold text-gray-600">Level</th>
                            </tr>
                        </thead>
                        <tbody id="bonusesTableDesktop"></tbody>
                    </table>
                </div>
                <div id="emptyBonusesDesktop" class="hidden text-center py-12">
                    <i class="fas fa-inbox text-gray-300 text-6xl mb-4"></i>
                    <p class="text-gray-500">Belum ada bonus</p>
                </div>
                <!-- Pagination Bonuses (Desktop) -->
                <div id="paginationContainerBonusesDesktop" class="hidden mt-6 flex items-center justify-between border-t border-gray-150 pt-4">
                    <div class="text-sm text-gray-600" id="paginationInfoBonusesDesktop"></div>
                    <div class="flex gap-1" id="paginationPagesBonusesDesktop"></div>
                </div>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>

    <div id="toast-container" class="fixed top-4 right-4 z-50"></div>

    <script src="/js/toast.js?v=<%= Date.now() %>"></script>
    <script src="/js/referral.js?v=<%= Date.now() %>"></script>
    <%- include('partials/pwa-script') %>
</body>
</html>
