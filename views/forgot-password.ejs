<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lupa Password - Kuotax</title>

    <meta name="description" content="Lupa password akun Kuotax Anda? Dapatkan link reset password instan melalui email terdaftar.">
    <link rel="icon" type="image/png" href="/images/icon.png">
    <link rel="stylesheet" href="/css/style.css?v=7">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        .login-input {
            width: 100%;
            padding: 14px 42px;
            border-radius: 12px;
            border: 1.5px solid #e5e7eb;
            background: #f9fafb;
            font-size: 15px;
            outline: none;
            transition: all 0.2s;
        }
        .login-input:focus {
            border-color: #10b981;
            background: #fff;
            box-shadow: 0 0 0 3px rgba(16,185,129,0.1);
        }
        .login-btn {
            width: 100%;
            padding: 14px;
            border-radius: 12px;
            background: #059669;
            color: #fff;
            font-weight: 700;
            font-size: 15px;
            border: none;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }
        .login-btn:hover {
            background: #047857;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(5,150,105,0.3);
        }
    </style>
</head>
<body class="bg-[#f8fafb] min-h-screen flex items-center justify-center p-4 selection:bg-emerald-500 selection:text-white">

    <div class="max-w-md w-full">
        <!-- Brand Header -->
        <div class="text-center mb-8">
            <a href="/login" class="inline-block">
                <img src="/images/logoa.png" alt="Kuotax" class="h-20 w-auto mx-auto mb-3">
            </a>
            <h1 class="text-2xl font-black text-gray-800 tracking-tight">Lupa Password?</h1>
            <p class="text-sm text-gray-500 mt-1">Masukkan email terdaftar Anda untuk menerima link pemulihan password.</p>
        </div>

        <!-- Form Card -->
        <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-xl border border-gray-100 relative overflow-hidden">
            <!-- Glow background -->
            <div class="absolute -top-20 -right-20 w-40 h-40 bg-emerald-500/10 rounded-full blur-2xl pointer-events-none"></div>

            <form id="forgotForm" class="space-y-5 relative z-10">
                <div>
                    <label class="block text-gray-700 text-xs font-bold mb-2 uppercase tracking-wide">Alamat Email Terdaftar</label>
                    <div class="relative">
                        <i class="fas fa-envelope absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
                        <input type="email" id="emailInput" name="email" required
                            class="login-input"
                            placeholder="nama@email.com">
                    </div>
                </div>

                <button type="submit" id="submitBtn" class="login-btn">
                    <i class="fas fa-paper-plane"></i> Kirim Link Reset Password
                </button>
            </form>

            <div class="mt-6 pt-5 border-t border-gray-100 text-center relative z-10">
                <a href="/login" class="text-xs font-bold text-gray-500 hover:text-gray-800 transition inline-flex items-center gap-1.5">
                    <i class="fas fa-arrow-left"></i> Kembali ke Halaman Login
                </a>
            </div>
        </div>
    </div>

    <div id="toast-container" class="fixed top-4 right-4 z-50"></div>

    <script src="/js/toast.js?v=<%= Date.now() %>"></script>
    <script>
    document.getElementById('forgotForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = document.getElementById('emailInput').value.trim();
        const btn = document.getElementById('submitBtn');
        const origHTML = btn.innerHTML;

        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Mengirim Email...';

        try {
            const response = await fetch('/api/auth/forgot-password', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email })
            });

            const result = await response.json();

            if (result.success) {
                showToast(result.message, 'success');
                btn.innerHTML = '<i class="fas fa-check-circle"></i> Email Terkirim!';
                btn.classList.add('bg-emerald-700');
            } else {
                showToast(result.message || 'Gagal mengirim email reset', 'error');
                btn.disabled = false;
                btn.innerHTML = origHTML;
            }
        } catch (error) {
            console.error('Forgot password error:', error);
            showToast('Terjadi kesalahan jaringan', 'error');
            btn.disabled = false;
            btn.innerHTML = origHTML;
        }
    });
    </script>
</body>
</html>
