<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Katalog PPOB - KUOTAX</title>
    <%- include('partials/pwa-head') %>
    <link rel="stylesheet" href="/css/style.css?v=6">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .glass {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.4);
        }
        .hide-scrollbar::-webkit-scrollbar { display: none; }
        .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
</head>
<body class="bg-gradient-to-br from-emerald-50 via-green-50 to-teal-50 min-h-screen">
    <%- include('partials/sidebar', { page: 'catalog' }) %>

    <!-- ============================================ -->
    <!-- MOBILE LAYOUT (visible only on < lg screens) -->
    <!-- ============================================ -->
    <div class="lg:hidden bg-[#f8fafb] min-h-screen pb-24">
        <!-- App Bar -->
        <div class="bg-white border-b border-gray-100 px-4 py-4 sticky top-0 z-20 flex items-center justify-between shadow-sm">
            <div>
                <h1 class="text-base font-bold text-gray-800 tracking-tight">Katalog Produk PPOB</h1>
                <p class="text-[11px] text-gray-500">Harga Modal & Estimasi Profit Grosir</p>
            </div>
            <div class="w-8 h-8 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center">
                <i class="fas fa-store text-sm"></i>
            </div>
        </div>

        <div class="p-4">
            <!-- Balance Banner Mobile -->
            <div class="bg-gradient-to-r from-emerald-800 to-teal-900 rounded-2xl p-4 shadow-md text-white mb-4">
                <div class="flex justify-between items-center">
                    <div>
                        <p class="text-emerald-200 text-[10px] uppercase font-bold tracking-wider">Saldo Deposit Aktif</p>
                        <p id="userBalanceMobile" class="text-xl font-extrabold text-white font-mono">Rp 0</p>
                    </div>
                    <a href="/deposit" class="px-3 py-1.5 bg-emerald-500 hover:bg-emerald-600 text-white font-bold rounded-xl text-xs flex items-center gap-1 shadow">
                        <i class="fas fa-plus-circle"></i> Deposit
                    </a>
                </div>
            </div>

            <!-- Informational Banner -->
            <div class="bg-blue-50/80 rounded-2xl p-3.5 mb-5 border border-blue-100 flex items-start gap-2.5">
                <i class="fas fa-info-circle text-blue-600 mt-0.5 text-sm shrink-0"></i>
                <div class="text-[11px] text-blue-900 leading-relaxed">
                    <strong>Informasi B2B Agregator:</strong> Seluruh produk kuota grosir di bawah ini disalurkan secara otomatis ke Saldo Deposit Anda melalui <strong>Live Order Stream</strong> di Dashboard saat saldo Anda cukup.
                </div>
            </div>

            <!-- Provider Filter Tabs Mobile -->
            <div id="providerTabsMobile" class="flex gap-2 overflow-x-auto pb-2 mb-4 hide-scrollbar"></div>

            <!-- Products Grid Mobile -->
            <div id="productGridMobile" class="grid gap-3"></div>
        </div>
    </div>

    <!-- ============================================ -->
    <!-- DESKTOP LAYOUT (visible only on >= lg screens) -->
    <!-- ============================================ -->
    <div class="hidden lg:block lg:ml-64 p-8 pb-8">
        <div class="mb-6 flex justify-between items-end">
            <div>
                <h1 class="text-3xl font-bold text-gray-800 mb-1">Katalog Produk & Harga Grosir PPOB</h1>
                <p class="text-gray-600">Daftar harga modal grosir resmi dan estimasi keuntungan B2B Agregator</p>
            </div>
            <div class="text-right">
                <p class="text-xs text-gray-500 mb-1">Saldo Deposit Aktif</p>
                <p id="userBalanceDesktop" class="text-2xl font-extrabold text-emerald-600 font-mono">Rp 0</p>
            </div>
        </div>

        <!-- Informational Banner Desktop -->
        <div class="glass rounded-2xl p-5 shadow-sm mb-6 border border-emerald-200/60 bg-gradient-to-r from-emerald-50/80 to-teal-50/80">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-emerald-600 text-white flex items-center justify-center shrink-0">
                    <i class="fas fa-satellite-dish text-lg"></i>
                </div>
                <div>
                    <h4 class="font-bold text-gray-900 text-sm">Bagaimana Cara Kerja Pengisian Order B2B?</h4>
                    <p class="text-xs text-gray-600">Anda tidak perlu menyetok kuota terpisah atau mencari pembeli sendiri. Ketika Saldo Deposit Anda aktif, orderan dari jaringan konter & server mitra akan disalurkan otomatis ke Dashboard Anda untuk Anda proses.</p>
                </div>
            </div>
        </div>

        <!-- Provider Filter Tabs Desktop -->
        <div id="providerTabsDesktop" class="flex gap-2 mb-6"></div>

        <!-- Products Grid Desktop -->
        <div id="productGridDesktop" class="grid grid-cols-2 xl:grid-cols-3 gap-4"></div>
    </div>

    <%- include('partials/footer') %>

    <div id="toast-container" class="fixed top-4 right-4 z-50"></div>

    <script src="/js/toast.js?v=<%= Date.now() %>"></script>
    <script src="/js/buy-quota.js?v=<%= Date.now() %>"></script>
    <%- include('partials/pwa-script') %>
</body>
</html>
