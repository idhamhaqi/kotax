    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        // Initialize AOS animations
        AOS.init({
            once: true,
            offset: 40,
            duration: 700,
            easing: 'ease-out-cubic'
        });

        // Calculator Interactive Logic
        document.addEventListener('DOMContentLoaded', function() {
            const modalValues = [300000, 500000, 1000000, 2000000, 5000000, 10000000];
            const slider = document.getElementById('modal-slider');
            const modalDisplay = document.getElementById('modal-display');
            const dailyDisplay = document.getElementById('daily-profit-display');
            const monthlyDisplay = document.getElementById('monthly-profit-display');

            function formatRupiah(number) {
                return 'Rp ' + Math.floor(number).toLocaleString('id-ID');
            }

            function updateCalculator() {
                if (!slider) return;
                const modal = modalValues[slider.value];
                const minMonthly = modal * 0.15;
                const maxMonthly = modal * 0.50;
                const minDaily = minMonthly / 30;
                const maxDaily = maxMonthly / 30;

                modalDisplay.textContent = formatRupiah(modal);
                if (dailyDisplay) dailyDisplay.textContent = formatRupiah(minDaily) + ' - ' + formatRupiah(maxDaily);
                if (monthlyDisplay) monthlyDisplay.textContent = formatRupiah(minMonthly) + ' - ' + formatRupiah(maxMonthly);
            }

            if (slider) {
                slider.addEventListener('input', updateCalculator);
                updateCalculator();
            }
        });
    </script>
