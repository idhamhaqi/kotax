                            <span id="daily-profit-display" class="text-emerald-700 font-black text-base md:text-lg font-mono">Rp 5.000 - Rp 16.666</span>
                        </div>
                    </div>
                    
                    <div class="text-center pt-5 border-t border-slate-200">
                        <p class="text-slate-600 text-xs font-bold mb-1">Total Keuntungan 30 Hari</p>
                        <h4 id="monthly-profit-display" class="text-2xl sm:text-3xl font-black text-gradient-gold mb-2">Rp 150.000 - Rp 500.000</h4>
                        <p class="text-[11px] text-slate-500 font-medium leading-normal">*Ilustrasi matematis berdasarkan rentang ROI 15%-50% dengan asumsi pemutaran modal penuh harian.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Program Affiliate / Referral Section -->
    <section id="affiliate" class="py-20 lg:py-28 bg-gradient-to-br from-emerald-900 via-teal-900 to-slate-900 text-white relative overflow-hidden border-t border-emerald-800/50">
        <!-- Abstract Glow Backgrounds -->
