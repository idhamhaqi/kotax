    <!-- How it Works Section -->
    <section id="how-it-works" class="py-20 lg:py-28 bg-white relative">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto mb-16" data-aos="fade-up">
                <span class="text-xs font-bold text-emerald-600 tracking-wider uppercase mb-2 block">Sistem Kerja Sederhana</span>
                <h2 class="text-3xl md:text-5xl font-black text-slate-900 mb-5 tracking-tight">Mekanisme Bisnis 3 Langkah</h2>
                <p class="text-base sm:text-lg text-slate-600 font-medium leading-relaxed">Sistem kami memotong semua kerumitan. Anda tidak perlu mencari pembeli manual, antrean pesanan dari mitra B2B disalurkan langsung secara realtime.</p>
            </div>

            <div class="grid md:grid-cols-3 gap-8 relative">
                <!-- Step 1 -->
                <div class="glass-card p-8 rounded-3xl text-center relative z-10" data-aos="fade-up" data-aos-delay="100">
                    <div class="w-16 h-16 mx-auto bg-gradient-to-br from-blue-500 to-blue-600 rounded-2xl flex items-center justify-center mb-6 shadow-lg shadow-blue-500/25 text-white text-2xl font-black">
                        1
                    </div>
                    <h3 class="text-xl font-bold text-slate-900 mb-3">Salurkan Likuiditas</h3>
                    <p class="text-slate-600 font-medium text-sm leading-relaxed">
                        Isi saldo deposit Anda sebagai Liquidity Provider. Saldo Anda siap diputar langsung untuk memproses antrean orderan B2B yang masuk secara otomatis.
                    </p>
                </div>
                
                <!-- Step 2 -->
                <div class="glass-card p-8 rounded-3xl text-center relative z-10" data-aos="fade-up" data-aos-delay="200">
                    <div class="w-16 h-16 mx-auto bg-gradient-to-br from-amber-400 to-orange-500 rounded-2xl flex items-center justify-center mb-6 shadow-lg shadow-orange-500/25 text-white text-2xl font-black">
                        2
                    </div>
                    <h3 class="text-xl font-bold text-slate-900 mb-3">Eksekusi Pesanan</h3>
                    <p class="text-slate-600 font-medium text-sm leading-relaxed">
                        Antrean pesanan dari seluruh penjuru Indonesia muncul secara live via WebSocket. Cukup klik <strong class="text-slate-900">"Fill Order"</strong> untuk mengambil alokasi.
                    </p>
                </div>
                
                <!-- Step 3 -->
                <div class="glass-card p-8 rounded-3xl text-center relative z-10 border-b-4 border-b-emerald-500" data-aos="fade-up" data-aos-delay="300">
                    <div class="w-16 h-16 mx-auto bg-gradient-to-br from-emerald-500 to-teal-600 rounded-2xl flex items-center justify-center mb-6 shadow-lg shadow-emerald-500/25 text-white text-2xl font-black">
                        3
                    </div>
                    <h3 class="text-xl font-bold text-slate-900 mb-3">Terima Hasil & Margin</h3>
                    <p class="text-slate-600 font-medium text-sm leading-relaxed">
                        Setelah pesanan dieksekusi, modal transaksi dikembalikan seketika beserta profit margin bersih yang langsung menambah Saldo Utama Anda.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- ROI / Profit Calculator Section -->
    <section class="py-20 lg:py-28 bg-slate-950 relative overflow-hidden border-t border-slate-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
                <div data-aos="fade-right">
                    <h2 class="text-3xl md:text-5xl font-black text-white mb-6 leading-tight tracking-tight">
                        Bagaimana Sistem Ini <br><span class="text-gradient-gold">Bekerja Untuk Anda?</span>
                    </h2>
                    <p class="text-base sm:text-lg text-slate-300 mb-8 leading-relaxed font-normal">
                        Dengan sistem <strong class="text-white">Smart ROI Target</strong>, likuiditas modal Anda diputar secara cerdas puluhan kali dalam sehari untuk memenuhi kebutuhan ribuan mitra konter secara efisien.
                    </p>
                    
                    <ul class="space-y-5">
                        <li class="flex items-start gap-4">
                            <div class="mt-1 w-9 h-9 rounded-xl bg-emerald-500/20 border border-emerald-500/30 flex items-center justify-center shrink-0 text-emerald-400">
                                <i class="fas fa-chart-line text-sm"></i>
                            </div>
                            <div>
                                <h3 class="text-base font-bold text-white mb-1">Perputaran Modal Cepat</h3>
                                <p class="text-slate-400 text-xs sm:text-sm leading-relaxed">Modal yang sama bisa Anda putar penuh setiap harinya. Semakin aktif, semakin tinggi hasil yang didapatkan.</p>
                            </div>
                        </li>
                        <li class="flex items-start gap-4">
                            <div class="mt-1 w-9 h-9 rounded-xl bg-emerald-500/20 border border-emerald-500/30 flex items-center justify-center shrink-0 text-emerald-400">
                                <i class="fas fa-network-wired text-sm"></i>
                            </div>
                            <div>
                                <h3 class="text-base font-bold text-white mb-1">Target Otomatis & Adil</h3>
                                <p class="text-slate-400 text-xs sm:text-sm leading-relaxed">Sistem pusat mengatur alokasi harian secara adil untuk semua agen yang bersaing.</p>
                            </div>
                        </li>
                    </ul>
                </div>
                
                <!-- Calculator Card -->
                <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-2xl relative" data-aos="fade-left" data-aos-delay="150">
                    <div class="absolute -top-3.5 right-6 bg-gradient-to-r from-amber-500 to-orange-500 text-white font-extrabold px-4 py-1 rounded-full shadow-md text-xs uppercase tracking-wider">
                        Simulasi ROI Bulanan
                    </div>
                    
                    <h3 class="text-lg font-bold text-slate-800 mb-6 text-center border-b border-slate-200 pb-4">Ilustrasi Perputaran Harian</h3>
                    
                    <div class="space-y-4 mb-6">
