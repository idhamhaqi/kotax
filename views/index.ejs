                            Lihat Cara Kerjanya
                        </a>
                    </div>
                    
                    <!-- Trust Badges -->
                    <div class="mt-10 flex flex-wrap items-center justify-center lg:justify-start gap-3 sm:gap-4 text-slate-700 text-xs sm:text-sm font-bold">
                        <div class="flex items-center gap-2 px-3.5 py-2 rounded-xl bg-white border border-slate-200 shadow-sm">
